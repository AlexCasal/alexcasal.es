---
import BaseLayout from "../layouts/BaseLayout.astro";

const publications = [
  {
    title: "FOSDEM 2026",
    eyebrow: "Conference",
    date: "Feb 2026",
    location: "Brussels, Belgium",
    status: "Draft",
    images: [
      {
        src: "/experiences/FOSDEM-01.jpg",
        alt: "People gathered at FOSDEM 2026.",
      },
      {
        src: "/experiences/FOSDEM-02.jpg",
        alt: "FOSDEM Meeting.",
      },
      {
        src: "/experiences/FOSDEM-03.jpg",
        alt: "GPUL Meet.",
      },
    ],
    summary:
      "A few days at FOSDEM 2026 surrounded by open source, late-night conversations, too many beers, and nearly 30 GPUL members sharing the experience together in Brussels.",
    body: "FOSDEM 2026 felt less like a conference and more like a meeting point for people who genuinely enjoy building things together. Between talks, devrooms, random hallway conversations, and nights ending way too late, most of the experience happened outside the schedule itself. What made it special was going there with GPUL. We were almost 30 members in Brussels, and that completely changed the atmosphere of the trip. Every day became a mix of learning, discussing ideas, meeting people from different communities, and ending up in some bar talking about open source, projects, infrastructure, Linux, or whatever came up after a few beers. This publication is a small reflection on the event, the people around it, and why communities like GPUL make experiences like FOSDEM feel much bigger than just another tech conference.",
  },
  {
    title: "HACKUDC 2026",
    eyebrow: "Event",
    date: "2026",
    location: "A Coruna, Spain",
    status: "Draft",
    images: [
      {
        src: "/experiences/HACKUDC-01.jpg",
        alt: "HackUDC Organization.",
      },
      {
        src: "/experiences/HACKUDC-02.jpg",
        alt: "HackUDC attendees gathered during the event.",
      },
      {
        src: "/experiences/HACKUDC-03.jpg",
        alt: "A HackUDC workshop session with participants.",
      },
    ],
    summary:
      "After attending HACKUDC for two years as a participant, 2026 was the first time I experienced the event from the other side: helping organize it, coordinating with people remotely, and learning how much work happens behind the scenes.",
    body: "For the past two years, HACKUDC was one of those events I always looked forward to as a participant. Building projects, meeting people, surviving on caffeine, and watching ideas turn into something real in just a weekend was already an amazing experience. But this year I wanted to understand how the event actually worked behind the scenes. So instead of joining with a team, I became part of the organization. HACKUDC 2026 taught me much more than I expected. A big part of the work happened months before the event itself: coordinating with people remotely, organizing tasks, solving problems constantly, talking with companies to build partnerships and sponsorships, and making sure hundreds of small details somehow worked together in the end. It was stressful at times, but also incredibly rewarding. Seeing participants enjoy the event while knowing everything that happened behind the curtain gave me a completely different perspective on community-driven projects and teamwork.",
  },
];
---

<BaseLayout
  title="Alex Casal | Experiences"
  description="Experience publications from Alex Casal: post-style reflections about events, lessons learned, and growth as a developer."
>
  <section
    class="relative overflow-hidden border-b border-[var(--line)] pb-16 lg:pb-20"
  >
    <div
      aria-hidden="true"
      class="absolute left-[10%] top-8 h-40 w-40 rounded-full bg-[var(--accent-soft)] blur-3xl"
    >
    </div>

    <div class="grid gap-10 lg:grid-cols-[1.5fr_0.5fr] lg:items-end">
      <div>
        <div class="flex items-center gap-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]"
          >
            Experiences / Publications
          </p>
          <span class="h-px flex-1 bg-[var(--line)]"></span>
        </div>

        <h1
          class="mt-6 font-display text-[clamp(3.8rem,10vw,8rem)] leading-[0.88] tracking-[-0.08em] text-[var(--ink)] text-shadow-soft"
        >
          Experiences, written while they are still warm.
        </h1>

        <div
          class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-[var(--muted)] sm:text-[1.28rem] sm:leading-9"
        >
          <p>
            This section collects post-style stories from real situations: what
            happened, what I learned, and how each experience changed my way of
            working.
          </p>
          <p>
            The first drafts are intentionally direct. I will keep polishing the
            text, but the page is ready to hold proper publications now.
          </p>
        </div>
      </div>
      <div></div>
    </div>
  </section>

  <section aria-labelledby="latest-publications" class="mt-20 lg:mt-28">
    <div
      class="flex items-end justify-between gap-6 border-b border-[var(--line)] pb-6"
    >
      <div>
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent-cool)]"
        >
          Latest notes
        </p>
        <h2
          id="latest-publications"
          class="mt-4 font-display text-[clamp(2.2rem,5vw,4.8rem)] leading-[0.92] tracking-[-0.07em] text-[var(--ink)]"
        >
          Publications
        </h2>
      </div>
      <p
        class="hidden max-w-xs text-right text-sm leading-6 text-[var(--soft)] sm:block"
      >
        Drafts first, better words later.
      </p>
    </div>

    <div class="mt-8 grid gap-5 lg:grid-cols-2">
      {
        publications.map((publication, publicationIndex) => (
          <article class="group flex min-h-[32rem] flex-col rounded-[2rem] border border-[var(--line)] bg-[var(--surface)] p-6 transition duration-300 hover:-translate-y-1 hover:border-[var(--line-strong)] sm:p-8">
            <div class="flex flex-wrap items-center gap-3">
              <span class="rounded-full border border-[var(--line)] bg-[var(--surface-soft)] px-3 py-1 font-mono text-[0.64rem] uppercase tracking-[0.22em] text-[var(--accent)]">
                {publication.eyebrow}
              </span>
              <span class="font-mono text-[0.64rem] uppercase tracking-[0.22em] text-[var(--soft)]">
                {publication.status}
              </span>
            </div>

            <h3 class="mt-8 max-w-[12ch] font-display text-[clamp(2.45rem,6vw,4.8rem)] leading-[0.92] tracking-[-0.07em] text-[var(--ink)]">
              {publication.title}
            </h3>

            <dl class="mt-7 grid gap-3 border-y border-[var(--line)] py-5 text-sm sm:grid-cols-2">
              <div>
                <dt class="font-mono text-[0.64rem] uppercase tracking-[0.22em] text-[var(--soft)]">
                  Date
                </dt>
                <dd class="mt-1 text-[var(--muted)]">{publication.date}</dd>
              </div>
              <div>
                <dt class="font-mono text-[0.64rem] uppercase tracking-[0.22em] text-[var(--soft)]">
                  Place
                </dt>
                <dd class="mt-1 text-[var(--muted)]">{publication.location}</dd>
              </div>
            </dl>

            <p class="mt-7 text-lg leading-8 text-[var(--muted)]">
              {publication.summary}
            </p>
            <p class="mt-5 text-base leading-7 text-[var(--soft)]">
              {publication.body}
            </p>

            <div
              class="mt-auto pt-8"
              data-carousel
              data-carousel-index={publicationIndex}
            >
              <div class="relative -mx-2 overflow-hidden rounded-[1.45rem] border border-[var(--line)] bg-[var(--surface-soft)] sm:-mx-4">
                <div
                  class="carousel-track flex transition-transform duration-500 ease-out"
                  data-carousel-track
                >
                  {publication.images.map((image) => (
                    <figure class="min-w-full">
                      <img
                        src={image.src}
                        alt={image.alt}
                        loading="lazy"
                        class="aspect-[16/10] w-full object-cover opacity-90 transition duration-500 group-hover:opacity-100"
                      />
                    </figure>
                  ))}
                </div>

                {publication.images.length > 1 && (
                  <div class="absolute inset-x-4 top-1/2 flex -translate-y-1/2 items-center justify-between">
                    <button
                      type="button"
                      aria-label={`Previous image for ${publication.title}`}
                      class="grid h-10 w-10 place-items-center rounded-full border border-[var(--line)] bg-[rgba(8,10,12,0.72)] text-xl leading-none text-[var(--ink)] backdrop-blur-xl transition duration-300 hover:border-[var(--line-strong)] hover:bg-[var(--surface-strong)]"
                      data-carousel-prev
                    >
                      <span aria-hidden="true">‹</span>
                    </button>
                    <button
                      type="button"
                      aria-label={`Next image for ${publication.title}`}
                      class="grid h-10 w-10 place-items-center rounded-full border border-[var(--line)] bg-[rgba(8,10,12,0.72)] text-xl leading-none text-[var(--ink)] backdrop-blur-xl transition duration-300 hover:border-[var(--line-strong)] hover:bg-[var(--surface-strong)]"
                      data-carousel-next
                    >
                      <span aria-hidden="true">›</span>
                    </button>
                  </div>
                )}
              </div>

              {publication.images.length > 1 && (
                <div class="mt-4 flex justify-center gap-2" data-carousel-dots>
                  {publication.images.map((_, imageIndex) => (
                    <button
                      type="button"
                      aria-label={`Show image ${imageIndex + 1} for ${publication.title}`}
                      class="h-2.5 w-2.5 rounded-full border border-[var(--line)] bg-[var(--surface-soft)] transition duration-300"
                      data-carousel-dot
                      data-carousel-dot-index={imageIndex}
                    />
                  ))}
                </div>
              )}
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <script>
    document.querySelectorAll("[data-carousel]").forEach((carousel) => {
      const track = carousel.querySelector("[data-carousel-track]");
      if (!(track instanceof HTMLElement)) return;

      const previousButton = carousel.querySelector("[data-carousel-prev]");
      const nextButton = carousel.querySelector("[data-carousel-next]");
      const dots = Array.from(
        carousel.querySelectorAll("[data-carousel-dot]"),
      ).filter((dot) => dot instanceof HTMLElement);
      const slideCount = track.children.length;
      let activeIndex = 0;

      const setActiveSlide = (nextIndex: number) => {
        if (slideCount < 2) return;

        activeIndex = (nextIndex + slideCount) % slideCount;
        track.style.transform = `translateX(-${activeIndex * 100}%)`;

        dots.forEach((dot, index) => {
          const isActive = index === activeIndex;
          dot.setAttribute("aria-current", isActive ? "true" : "false");
          dot.style.backgroundColor = isActive ? "var(--accent)" : "";
          dot.style.borderColor = isActive ? "var(--accent)" : "";
        });
      };

      previousButton?.addEventListener("click", () => {
        setActiveSlide(activeIndex - 1);
      });

      nextButton?.addEventListener("click", () => {
        setActiveSlide(activeIndex + 1);
      });

      dots.forEach((dot) => {
        dot.addEventListener("click", () => {
          const dotIndex = Number(dot.getAttribute("data-carousel-dot-index"));
          setActiveSlide(dotIndex);
        });
      });

      setActiveSlide(0);
    });
  </script>
</BaseLayout>
