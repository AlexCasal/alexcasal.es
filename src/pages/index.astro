---
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

---

<BaseLayout
  title="Alex Casal - Full-stack Developer and LeadQuiry Co-founder"
  description="Portfolio of Alex Casal, full-stack developer in Berlin and co-founder of LeadQuiry, building web products with React, Next.js, Astro, TypeScript and modern web technologies."
>
  <Hero
    title="Full-stack Developer and Co-founder based in Berlin."
    intro="I build clean, responsive web applications and co-founded LeadQuiry, a SaaS product for finding and managing business leads. I enjoy turning product ideas into useful, well-structured experiences while working across frontend, backend, data, and the decisions that connect them."
    image="/profile_01.jpg"
    imageAlt="Portrait of Alex Casal"
    actions={[
      { href: "/projects", label: "View projects", detail: "/projects" },
      { href: "/docs/CV_Alex.pdf", label: "Download CV", detail: "PDF" },
      { href: "/contact", label: "Contact me", detail: "/contact" },
    ]}
    meta={[
      { label: "Location", value: "Berlin, Germany" },
      { label: "Current focus", value: "Co-founder at LeadQuiry / full-stack development" },
      { label: "Availability", value: "Open to interviews" },
    ]}
  />

  <section aria-labelledby="leadquiry" class="mt-12 lg:mt-16">
    <div class="accent-panel overflow-hidden rounded-[2rem] border border-[var(--line)] p-6 sm:p-8 lg:p-10">
      <div class="grid gap-10 lg:grid-cols-[minmax(0,0.72fr)_minmax(0,1.28fr)] lg:items-end">
        <div>
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent-cool)]">
            Co-founder / Active product
          </p>
          <h2 id="leadquiry" class="mt-4 max-w-[9ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
            Building LeadQuiry.
          </h2>
        </div>

        <div>
          <p class="max-w-3xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
            LeadQuiry is a lead-generation SaaS that helps businesses find, organize, and export potential customers from one focused workflow. As co-founder, I work across product decisions, interface design, full-stack development, data persistence, and the systems behind a real subscription product.
          </p>
          <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              href="https://leadquiry.com"
              target="_blank"
              rel="noreferrer"
              class="inline-flex items-center justify-between gap-4 rounded-full bg-[var(--accent)] px-5 py-3 text-sm text-[#0b0d10] transition duration-300 hover:-translate-y-0.5 hover:bg-[var(--accent-strong)]"
            >
              Visit LeadQuiry
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[#0b0d10]/65">Live</span>
            </a>
            <a
              href="/projects#leadquiry"
              class="accent-button inline-flex items-center justify-between gap-4 rounded-full border bg-[var(--surface-soft)] px-5 py-3 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5"
            >
              Read the project case
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">/projects</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="open-to-work" class="mt-12 lg:mt-16">
    <div class="accent-panel rounded-[2rem] border border-[var(--line)] p-6 sm:p-8">
      <div class="grid gap-8 lg:grid-cols-[minmax(0,0.75fr)_minmax(0,1.25fr)] lg:items-start">
        <div>
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent-cool)]">
            Open to work
          </p>
          <h2 id="open-to-work" class="mt-4 max-w-[11ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl">
            Looking for a junior developer role.
          </h2>
        </div>
        <div class="grid gap-6 md:grid-cols-2">
          <div>
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
              Currently open to
            </p>
            <ul class="mt-4 grid gap-2 text-base leading-7 text-[var(--muted)]">
              <li>Junior Full-stack Developer roles</li>
              <li>Junior Software Developer roles</li>
              <li>JavaScript / TypeScript web roles</li>
              <li>Berlin hybrid, Berlin onsite, or remote EU</li>
            </ul>
          </div>
          <dl class="grid gap-4">
            <div>
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">Location</dt>
              <dd class="mt-1 text-base leading-7 text-[var(--ink)]">Berlin, Germany</dd>
            </div>
            <div>
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">Languages</dt>
              <dd class="mt-1 text-base leading-7 text-[var(--ink)]">Spanish and English</dd>
            </div>
            <div>
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">Availability</dt>
              <dd class="mt-1 text-base leading-7 text-[var(--ink)]">Open to interviews</dd>
            </div>
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="featured-projects" class="mt-20 lg:mt-28">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.55fr)_minmax(0,1.45fr)] lg:gap-14">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="font-mono text-[0.9rem] uppercase tracking-[0.3em] text-[var(--accent)]">
          selected projects
        </p>
        <h2 id="featured-projects" class="mt-4 max-w-[8ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
          Selected finished projects.
        </h2>
        <a
          href="/projects"
          class="mt-8 inline-flex items-center gap-3 rounded-full border border-[var(--line)] bg-[var(--surface-soft)] px-5 py-3 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5 hover:border-[var(--line-strong)] hover:bg-[var(--surface)]"
        >
          Visit all projects
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">/projects</span>
        </a>
      </div>

      <div class="border-t border-[var(--line-strong)]">
        <a
          href="/projects#leadquiry"
          class="group block rounded-[2rem] border-b border-[var(--line)] bg-[linear-gradient(135deg,rgba(216,255,86,0.1),transparent_45%)] py-8 transition duration-300 hover:border-[var(--line-strong)] lg:px-8"
        >
          <div class="flex items-center justify-between gap-5">
            <span class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
              01
            </span>
            <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
              SaaS / Co-founder
            </span>
          </div>
          <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-end">
            <h3 class="font-display text-[clamp(2.9rem,6vw,5.8rem)] leading-[0.92] tracking-[-0.07em] text-[var(--ink)] transition duration-300 group-hover:text-[var(--accent-strong)]">
              LeadQuiry
            </h3>
            <div>
              <p class="max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
                A lead-generation SaaS for finding, organizing, and exporting potential customers, built around a focused workflow and a credit-based product model.
              </p>
              <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Next.js</span>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Active product</span>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Co-founder</span>
              </div>
            </div>
          </div>
        </a>

        <a
          href="/projects#alexcasal.es"
          class="group block border-b border-[var(--line)] py-8 transition duration-300 hover:border-[var(--line-strong)] lg:px-4"
        >
          <div class="flex items-center justify-between gap-5">
            <span class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
              02
            </span>
            <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
              Personal website
            </span>
          </div>
          <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-end">
            <h3 class="font-display text-[clamp(2.2rem,4.4vw,4rem)] leading-[0.92] tracking-[-0.07em] text-[var(--ink)] transition duration-300 group-hover:text-[var(--accent-strong)]">
              alexcasal.es
            </h3>
            <div>
              <p class="max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
                The site itself: an Astro-based portfolio built to present projects, developer experience, and job-search signals without losing personality.
              </p>
              <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Astro</span>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Ongoing</span>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Apr 2026</span>
              </div>
            </div>
          </div>
        </a>

        <a
          href="/projects#zara-challenge"
          class="group block border-b border-[var(--line)] py-8 transition duration-300 hover:border-[var(--line-strong)] lg:px-4"
        >
          <div class="flex items-center justify-between gap-5">
            <span class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
              03
            </span>
            <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
              Frontend challenge
            </span>
          </div>
          <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-end">
            <h3 class="font-display text-[clamp(2.2rem,4.4vw,4rem)] leading-[0.92] tracking-[-0.07em] text-[var(--ink)] transition duration-300 group-hover:text-[var(--accent-strong)]">
              Zara Challenge
            </h3>
            <div>
              <p class="max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
                A retail product browsing interface based on a technical challenge, focused on API data, reusable React components, and responsive catalogue UI.
              </p>
              <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">React</span>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Shipped</span>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Mar 2026</span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  

  <section class="mt-20 border-t border-[var(--line-strong)] pt-12 lg:mt-28 lg:pt-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:items-start">
      <div>
        <p class="font-mono text-[0.9rem] uppercase tracking-[0.3em] text-[var(--accent)]">
          Berlin / next step
        </p>
        <h2 class="mt-4 max-w-[12ch] font-display text-4xl leading-[0.94] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
          What I am looking for now.
        </h2>
      </div>
      <p class="max-w-3xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
        I recently moved to Berlin to grow as a developer and join a product-focused team. I am especially interested in startups, developer tools, SaaS products, e-commerce, creative technology, and teams where I can learn fast while contributing to real features.
      </p>
    </div>
  </section>

  <section class="mt-20 border-t border-[var(--line-strong)] pt-12 lg:mt-28 lg:pt-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-start">
      <div>
        <p class="font-mono text-[0.9rem] uppercase tracking-[0.3em] text-[var(--accent)]">
          contact
        </p>
        <h2 class="mt-4 max-w-[11ch] font-display text-4xl leading-[0.94] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
          Hiring junior developers in Berlin or remote?
        </h2>
      </div>

      <div class="rounded-[2rem] border border-[var(--line)] bg-[var(--surface)] p-6 sm:p-8">
        <p class="max-w-md text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
          I am open to interviews for junior full-stack and software developer roles, especially on teams building real products with clear user value.
        </p>
        <a
          href="/contact"
          class="mt-6 inline-flex items-center gap-3 rounded-full bg-[var(--accent)] px-5 py-3 text-sm text-[#0b0d10] transition duration-300 hover:-translate-y-0.5 hover:bg-[var(--accent-strong)]"
        >
          Contact me
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[#0b0d10]/65">/contact</span>
        </a>
        <p class="mt-6 font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">
          Usually replies within 24-48 hours
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
