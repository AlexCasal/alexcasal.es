---
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

---

<BaseLayout
  title="Hello!!"
>
  <Hero
    title="I like finding efficient ways to solve problems."
    intro="This homepage is a live page for projects, experiences, prototypes, and some new things that if I have time and I get bored I will implement. It is mean to feel closer to a working surface than a polished CV."
    image="/profile_01.jpg"
    imageAlt="Portrait of Alex Casal"
    actions={[
      { href: "/projects", label: "My projects", detail: "Details" },
      { href: "/lab", label: "The lab", detail: "Work in progress" },
      { href: "/experiences", label: "Experiences", detail: "Stories and lessons" },
    ]}
  />

  <section aria-labelledby="featured-projects" class="mt-20 lg:mt-28">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.55fr)_minmax(0,1.45fr)] lg:gap-14">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="font-mono text-[0.9rem] uppercase tracking-[0.3em] text-[var(--accent)]">
          some projects
        </p>
        <h2 id="featured-projects" class="mt-4 max-w-[8ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
          Here you can find some things 'finished' :)
        </h2>
        <a
          href="/projects"
          class="mt-8 inline-flex items-center gap-3 rounded-full border border-[var(--line)] bg-[var(--surface-soft)] px-5 py-3 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5 hover:border-[var(--line-strong)] hover:bg-[var(--surface)]"
        >
          Visit all projects
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">/projects</span>
        </a>
      </div>

      <div class="border-t border-[var(--line-strong)]">
        <a
          href="/projects#alexcasal-es"
          class="group block rounded-[2rem] border-b border-[var(--line)] bg-[linear-gradient(135deg,rgba(216,255,86,0.1),transparent_45%)] py-8 transition duration-300 hover:border-[var(--line-strong)] lg:px-8"
        >
          <div class="flex items-center justify-between gap-5">
            <span class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
              01
            </span>
            <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
              Personal website
            </span>
          </div>
          <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-end">
            <h3 class="font-display text-[clamp(2.9rem,6vw,5.8rem)] leading-[0.92] tracking-[-0.07em] text-[var(--ink)] transition duration-300 group-hover:text-[var(--accent-strong)]">
              alexcasal.es
            </h3>
            <div>
              <p class="max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
                The site itself: an Astro-based personal website that tries to behave more like a studio surface than a standard portfolio.
              </p>
              <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Astro</span>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Ongoing</span>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Apr 2026</span>
              </div>
            </div>
          </div>
        </a>

        <a
          href="/projects#zara-challenge"
          class="group block border-b border-[var(--line)] py-8 transition duration-300 hover:border-[var(--line-strong)] lg:px-4"
        >
          <div class="flex items-center justify-between gap-5">
            <span class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
              02
            </span>
            <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
              Frontend challenge
            </span>
          </div>
          <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-end">
            <h3 class="font-display text-[clamp(2.2rem,4.4vw,4rem)] leading-[0.92] tracking-[-0.07em] text-[var(--ink)] transition duration-300 group-hover:text-[var(--accent-strong)]">
              zara-challenge
            </h3>
            <div>
              <p class="max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
                A retail front-end application originally built as part of a technical interview process for Massimo Dutti, focused on consuming a product API and creating a clean, scalable browsing experience.
              <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">React</span>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Shipped</span>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Mar 2026</span>
              </div>
            </div>
          </div>
        </a>

        <a
          href="/projects#hackudc-2026"
          class="group block border-b border-[var(--line)] py-8 transition duration-300 hover:border-[var(--line-strong)] lg:px-4"
        >
          <div class="flex items-center justify-between gap-5">
            <span class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
              03
            </span>
            <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
              Event website
            </span>
          </div>
          <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-end">
            <h3 class="font-display text-[clamp(2.2rem,4.4vw,4rem)] leading-[0.92] tracking-[-0.07em] text-[var(--ink)] transition duration-300 group-hover:text-[var(--accent-strong)]">
              HackUDC 2026
            </h3>
            <div>
              <p class="max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
                The official site for HackUDC 2026. More public-facing, more information-heavy, and built with a stronger collaboration constraint.
              </p>
              <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Astro</span>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Collaboration</span>
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">Jan 2026</span>
              </div>
            </div>
          </div>
        </a>
      </div>
    </div>
  </section>

  

  <section class="mt-20 border-t border-[var(--line-strong)] pt-12 lg:mt-28 lg:pt-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-start">
      <div>
        <p class="font-mono text-[0.9rem] uppercase tracking-[0.3em] text-[var(--accent)]">
          contact?
        </p>
        <h2 class="mt-4 max-w-[11ch] font-display text-4xl leading-[0.94] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
          Need a site, system, or experiment with a point of view?
        </h2>
      </div>

      <div class="rounded-[2rem] border border-[var(--line)] bg-[var(--surface)] p-6 sm:p-8">
        <p class="max-w-md text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
          For collaborations, commissions, or conversations about web work that should feel more intentional than standard product polish.
        </p>
        <a
          href="/contact"
          class="mt-6 inline-flex items-center gap-3 rounded-full bg-[var(--accent)] px-5 py-3 text-sm text-[#0b0d10] transition duration-300 hover:-translate-y-0.5 hover:bg-[var(--accent-strong)]"
        >
          Open contact
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[#0b0d10]/65">/contact</span>
        </a>
        <p class="mt-6 font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">
          Response cadence / human 
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
