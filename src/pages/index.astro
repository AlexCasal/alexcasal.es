---
import Hero from "../components/Hero.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const manifestoItems = [
  {
    title: "A garden, not an archive.",
    text: "Notes, references, loose sketches, and finished work are allowed to sit together. The site should reveal how ideas connect, not just how they conclude.",
    tag: "thinking in public",
  },
  {
    title: "A studio, not a template.",
    text: "Projects need framing, language, and point of view. The interface should communicate taste and intent before it starts listing tools or achievements.",
    tag: "edited",
  },
  {
    title: "A lab, not a leftovers bin.",
    text: "Experiments deserve first-class space. Half-finished prototypes, interaction studies, and strange side paths are part of the practice, not a separate category of less serious work.",
    tag: "still moving",
  },
];

const featuredProjects = [
  {
    title: "Publishing System",
    kind: "System design",
    summary:
      "A modular publishing setup for essays, notes, and references that keeps the output calm while letting the structure stay flexible underneath.",
    tags: ["Astro", "Content architecture", "Performance"],
    href: "/projects",
  },
  {
    title: "Archive Interface",
    kind: "Interface study",
    summary:
      "A navigation experiment for collections, fragments, and linked material that moves away from the default grid-of-cards approach.",
    tags: ["Information design", "Navigation"],
    href: "/projects",
  },
  {
    title: "Motion Fragments",
    kind: "Prototype series",
    summary:
      "Small interaction pieces focused on rhythm, typography, and tactile movement with very little client-side JavaScript.",
    tags: ["Motion", "Minimal JS"],
    href: "/projects",
  },
];
---

<BaseLayout
  title="Alex Casal"
>
  <Hero
    eyebrow="Index / 01"
    title="Building things in public"
    intro="This homepage is a live page for projects, notes, prototypes, and some new things that If have time and I get bored I will implement. It is meant to feel closer to a working surface than a polished CV."
    note="The goal is clarity without flattening the work into a standard portfolio pattern. Finished pieces and unfinished thinking are both part of the signal."
    actions={[
      { href: "/projects", label: "My projects", detail: "Details" },
      { href: "/lab", label: "The lab", detail: "Work in progress" },
      { href: "/notes", label: "Notes", detail: "Guides and more" },
    ]}
  />

  <section aria-labelledby="featured-projects" class="mt-20 lg:mt-28">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.55fr)_minmax(0,1.45fr)] lg:gap-14">
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]">
          Featured projects
        </p>
        <h2 id="featured-projects" class="mt-4 max-w-[8ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
          Selected work with more presence than a grid.
        </h2>
        <p class="mt-6 max-w-md text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
          Instead of a wall of cards, the homepage treats projects like entries in a front-page lineup. Each one should feel like a route into a fuller case study.
        </p>
        <a
          href="/projects"
          class="mt-8 inline-flex items-center gap-3 rounded-full border border-[var(--line)] bg-[var(--surface-soft)] px-5 py-3 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5 hover:border-[var(--line-strong)] hover:bg-[var(--surface)]"
        >
          Visit all projects
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">/projects</span>
        </a>
      </div>

      <div class="border-t border-[var(--line-strong)]">
        {featuredProjects.map((project, index) => (
          <a
            href={project.href}
            class:list={[
              "group block border-b border-[var(--line)] py-8 transition duration-300 hover:border-[var(--line-strong)] lg:px-4",
              index === 0 && "rounded-[2rem] bg-[linear-gradient(135deg,rgba(216,255,86,0.1),transparent_45%)] lg:px-8",
            ]}
          >
            <div class="flex items-center justify-between gap-5">
              <span class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
                {String(index + 1).padStart(2, "0")}
              </span>
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                {project.kind}
              </span>
            </div>

            <div class="mt-6 grid gap-6 lg:grid-cols-[minmax(0,0.78fr)_minmax(0,1.22fr)] lg:items-end">
              <h3 class:list={[
                "font-display leading-[0.92] tracking-[-0.07em] text-[var(--ink)] transition duration-300 group-hover:text-[var(--accent-strong)]",
                index === 0 ? "text-[clamp(2.9rem,6vw,5.8rem)]" : "text-[clamp(2.2rem,4.4vw,4rem)]",
              ]}>
                {project.title}
              </h3>

              <div>
                <p class="max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
                  {project.summary}
                </p>
                <div class="mt-5 flex flex-wrap gap-x-4 gap-y-2">
                  {project.tags.map((tag) => (
                    <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  

  <section class="mt-20 border-t border-[var(--line-strong)] pt-12 lg:mt-28 lg:pt-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:items-start">
      <div>
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]">
          Contact
        </p>
        <h2 class="mt-4 max-w-[11ch] font-display text-4xl leading-[0.94] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
          Need a site, system, or experiment with a point of view?
        </h2>
      </div>

      <div class="rounded-[2rem] border border-[var(--line)] bg-[var(--surface)] p-6 sm:p-8">
        <p class="max-w-md text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
          For collaborations, commissions, or conversations about web work that should feel more intentional than standard product polish.
        </p>
        <a
          href="/contact"
          class="mt-6 inline-flex items-center gap-3 rounded-full bg-[var(--accent)] px-5 py-3 text-sm text-[#0b0d10] transition duration-300 hover:-translate-y-0.5 hover:bg-[var(--accent-strong)]"
        >
          Open contact
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[#0b0d10]/65">/contact</span>
        </a>
        <p class="mt-6 font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">
          Response cadence / human
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
