---
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const profileUrl = "https://github.com/AlexCasal?tab=repositories";

const projects = [
  {
    name: "alexcasal.es",
    title: "alexcasal.es",
    kind: "Personal website",
    summary:
      "The site itself: an Astro-based portfolio built to present projects, developer experience, and job-search signals without losing personality.",
    problem:
      "My old portfolio felt personal and creative, but recruiters needed a faster way to understand my role focus, stack, projects, and availability.",
    built:
      "I built a responsive Astro site with reusable page sections, project cards, focused metadata, and clear routes for projects, experience, contact, CV, GitHub, and LinkedIn.",
    techStack: ["Astro", "JavaScript", "HTML", "CSS", "Tailwind"],
    learned:
      "I learned how to balance personality with conversion, structure content for hiring teams, and keep a static site maintainable as my profile changes.",
    highlights: [
      "Built with Astro",
      "Responsive portfolio layout",
      "Recruiter-focused content structure",
      "Reusable components",
      "Deployed as a personal website",
    ],
    githubUrl: "https://github.com/AlexCasal/alexcasal.es",
    liveUrl: "https://alexcasal.es",
    language: "Astro",
    updatedLabel: "Apr 2026",
    status: "Ongoing",
  },
  {
    name: "zara-challenge",
    title: "Zara Challenge",
    kind: "Frontend challenge",
    summary:
      "Built a retail product browsing interface based on a technical challenge. The app consumes product data from an API, renders a clean responsive catalogue, and focuses on component structure, reusable UI, and maintainable React code.",
    problem:
      "The challenge was to create a product browsing experience that could present API data clearly, work across screen sizes, and stay easy to extend.",
    built:
      "I built a React catalogue interface with product fetching, responsive grid layouts, reusable UI components, and deployment on Vercel.",
    techStack: ["React", "JavaScript", "CSS", "REST API", "Vercel"],
    learned:
      "I practiced organizing React components around real product data, handling API-driven UI, and polishing responsive catalogue states for a retail context.",
    highlights: [
      "Built with React",
      "Consumed external product API",
      "Responsive product grid",
      "Component-based structure",
      "Deployed on Vercel",
    ],
    githubUrl: "https://github.com/AlexCasal/zara-challenge",
    liveUrl: "https://zara-challenge-rouge.vercel.app",
    language: "React",
    updatedLabel: "Mar 2026",
    status: "Shipped",
  },
  {
    name: "hackudc-2026",
    title: "HackUDC 2026",
    kind: "Event website",
    summary:
      "The official site for HackUDC 2026, built as part of a web team for a 400+ participant hackathon with sponsors, schedules, and public event information.",
    problem:
      "The event needed a public website that could communicate key information clearly to participants, sponsors, and the wider technical community.",
    built:
      "I helped build and maintain the event website, structure content for different audiences, and collaborate remotely with organizers around timing, updates, and sponsor-facing information.",
    techStack: ["Astro", "JavaScript", "HTML", "CSS", "GitHub"],
    learned:
      "I learned more about working in a distributed team, shipping public-facing event updates, and communicating technical work with non-technical constraints.",
    highlights: [
      "Built with Astro",
      "Worked with an organizing team",
      "Supported sponsor and event communication",
      "Public-facing responsive website",
      "Community and open-source context",
    ],
    githubUrl: "https://github.com/AlexCasal/hackudc-2026",
    liveUrl: "https://hackudc.gpul.org/",
    language: "Astro",
    updatedLabel: "Jan 2026",
    status: "Collaboration",
  },
  {
    name: "personal-web",
    title: "Personal Web",
    kind: "Earlier iteration",
    summary:
      "A previous personal website and a useful archive point for how the current direction grew out of something simpler and more conventional.",
    problem:
      "I needed an early portfolio presence while I was still clarifying how to present my work and development direction.",
    built:
      "I built a simpler static personal website to practice layout, navigation, content structure, and publishing a personal profile online.",
    techStack: ["HTML", "CSS", "JavaScript", "GitHub Pages"],
    learned:
      "I learned what a basic portfolio needs, what felt too generic, and how that first version could evolve into a more focused developer site.",
    highlights: [
      "Static website",
      "Responsive layout practice",
      "Early portfolio iteration",
      "HTML and CSS fundamentals",
      "Archived for progression",
    ],
    githubUrl: "https://github.com/AlexCasal/personal-web",
    liveUrl: null,
    language: "HTML",
    updatedLabel: "Oct 2025",
    status: "Archive",
  },
];
---

<BaseLayout
  title="Alex Casal | Projects"
  description="Selected projects from Alex Casal, junior full-stack software developer in Berlin: React, Astro, JavaScript, APIs, Node.js, and responsive web interfaces."
  page="projects"
>
  <section
    class="page-hero relative overflow-hidden border-b border-[var(--line)] pb-16 lg:pb-20"
  >
    <div
      aria-hidden="true"
      class="absolute left-[12%] top-8 h-40 w-40 rounded-full bg-[var(--accent-soft)] blur-3xl"
    >
    </div>

    <div class="grid gap-10 lg:grid-cols-[1.5fr_0.5fr] lg:items-end">
      <div>
        <div class="flex items-center gap-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]"
          >
            Projects / 03
          </p>
          <span class="h-px flex-1 bg-[var(--line)]"></span>
        </div>

        <h1
          class="mt-6 font-display text-[clamp(3.8rem,10vw,8rem)] leading-[0.88] tracking-[-0.08em] text-[var(--ink)] text-shadow-soft"
        >
          Selected work, not a repo dump.
        </h1>

        <div
          class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-[var(--muted)] sm:text-[1.28rem] sm:leading-9"
        >
          <p>
            This page is a curated read of the work, not a mirror of everything
            that happens to live on GitHub. The point is selection, framing, and
            enough context for hiring teams to understand what I built, how I
            think, and what I learned.
          </p>
          <p></p>
          <dd class="mt-9">
            <a
              href={profileUrl}
              target="_blank"
              rel="noreferrer"
              class="accent-button inline-flex items-center gap-3 rounded-full border bg-[var(--surface-soft)] px-4 py-2 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5"
            >
              Do you want to see all my repos?
              <span
                class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]"
                >Here is my GitHub</span
              >
            </a>
          </dd>
        </div>
      </div>
    </div>

    <section aria-labelledby="project-signals" class="mt-16 lg:mt-20">
      <div
        class="accent-panel rounded-[2rem] border border-[var(--line)] p-6 sm:p-8"
      >
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent-cool)]"
        >
          Before you scroll
        </p>
        <h2
          id="project-signals"
          class="mt-5 max-w-[16ch] font-display text-[clamp(2rem,4vw,3.6rem)] leading-[0.95] tracking-[-0.07em] text-[var(--ink)]"
        >
          Selected finished projects.
        </h2>
        <p
          class="mt-4 max-w-3xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8"
        >
          If you want to see work in progress, half-built ideas, and experiments
          that are still evolving, head to the Laboratory section.
        </p>
        <dd class="mt-9">
          <a
            href="/lab"
            target="_blank"
            rel="noreferrer"
            class="accent-button inline-flex items-center gap-3 rounded-full border bg-[var(--surface-soft)] px-4 py-2 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5"
          >
            Do you want to go to the lab?
            <span
              class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]"
              >Here is the Lab</span
            >
          </a>
        </dd>
      </div>
    </section>

    <ProjectGrid projects={projects} profileUrl={profileUrl} />
  </section>
</BaseLayout>
