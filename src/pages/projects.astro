---
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const profileUrl = "https://github.com/AlexCasal?tab=repositories";

const projects = [
  {
    name: "alexcasal.es",
    title: "alexcasal.es",
    kind: "Personal website",
    summary:
      "The site itself: an Astro-based personal internet that tries to behave more like a studio surface than a standard portfolio.",
    githubUrl: "https://github.com/AlexCasal/alexcasal.es",
    liveUrl: null,
    language: "Astro",
    updatedLabel: "Apr 2026",
    status: "Ongoing",
  },
  {
    name: "zara-challenge",
    title: "Zara Challenge",
    kind: "Frontend challenge",
    summary:
      "A retail interface exercise focused on structure, browsing clarity, and translating a familiar product system into a sharper front-end build.",
    githubUrl: "https://github.com/AlexCasal/zara-challenge",
    liveUrl: "https://zara-challenge-rouge.vercel.app",
    language: "JavaScript",
    updatedLabel: "Mar 2026",
    status: "Shipped",
  },
  {
    name: "hackudc-2026",
    title: "HackUDC 2026",
    kind: "Event website",
    summary:
      "The official site for HackUDC 2026. More public-facing, more information-heavy, and built with a stronger collaboration constraint.",
    githubUrl: "https://github.com/AlexCasal/hackudc-2026",
    liveUrl: "https://hackudc.gpul.org/",
    language: "Astro",
    updatedLabel: "Jan 2026",
    status: "Collaboration",
  },
  {
    name: "personal-web",
    title: "Personal Web",
    kind: "Earlier iteration",
    summary:
      "A previous personal website and a useful archive point for how the current direction grew out of something simpler and more conventional.",
    githubUrl: "https://github.com/AlexCasal/personal-web",
    liveUrl: null,
    language: "HTML",
    updatedLabel: "Oct 2025",
    status: "Archive",
  },
];

const signals = [
  {
    label: "Selection",
    value: "4 curated repositories",
    text: "This page stays edited on purpose. GitHub has more context, but these are the clearest public markers of the work right now.",
  },
  {
    label: "Format",
    value: "Case-study bias",
    text: "The goal is not equal treatment for every repo. It is better framing, clearer language, and stronger hierarchy around the work that matters most.",
  },
  {
    label: "Elsewhere",
    value: "Lab holds the rough edges",
    text: "Experiments, unfinished fragments, and stranger ideas belong in the lab instead of being flattened into the same project presentation.",
  },
];

const routes = [
  {
    href: "/lab",
    note: "Open experiments",
    title: "The unfinished side lives in the lab.",
    text: "Prototypes, interaction tests, and work that is still trying to decide what it wants to become.",
  },
  {
    href: "/contact",
    note: "Start a conversation",
    title: "If one of these points toward a collaboration, say hello.",
    text: "For site work, front-end systems, or projects that need stronger structure and a more deliberate visual point of view.",
  },
];
---

<BaseLayout
  title="Alex Casal | Projects"
  description="Selected projects from Alex Casal: an edited set of websites, interface work, and public builds."
>
  <section class="relative overflow-hidden border-b border-[var(--line)] pb-16 lg:pb-20">
    <div aria-hidden="true" class="absolute left-[12%] top-8 h-40 w-40 rounded-full bg-[var(--accent-soft)] blur-3xl"></div>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] lg:items-end">
      <div>
        <div class="flex items-center gap-4">
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]">
            Projects / 03
          </p>
          <span class="h-px flex-1 bg-[var(--line)]"></span>
        </div>

        <h1 class="mt-6 max-w-[8ch] font-display text-[clamp(3.8rem,10vw,8rem)] leading-[0.88] tracking-[-0.08em] text-[var(--ink)] text-shadow-soft">
          Selected work, not a repo dump.
        </h1>

        <div class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-[var(--muted)] sm:text-[1.28rem] sm:leading-9">
          <p>
            This page is a curated read of the work, not a mirror of everything that happens to live on GitHub. The point is selection, framing, and enough context to make the shape of the practice legible.
          </p>
          <p>
            Some projects are more resolved, some are collaborative, and some matter because they show an earlier version of the same line of thinking. They do not need identical treatment to belong together.
          </p>
        </div>
      </div>

      <aside class="lg:pb-2">
        <div class="rounded-[2rem] border border-[var(--line)] bg-[linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.01))] p-6 sm:p-8">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.28em] text-[var(--accent-cool)]">
            Reading guide
          </p>

          <dl class="mt-6 space-y-5">
            <div class="border-t border-[var(--line)] pt-5 first:border-t-0 first:pt-0">
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                Source
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                A static selection pulled from public repositories, then edited into a stronger project page.
              </dd>
            </div>

            <div class="border-t border-[var(--line)] pt-5">
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                Bias
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                Interfaces with clearer hierarchy, fast front ends, and websites that feel authored rather than templated.
              </dd>
            </div>

            <div class="border-t border-[var(--line)] pt-5">
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                Full index
              </dt>
              <dd class="mt-3">
                <a
                  href={profileUrl}
                  target="_blank"
                  rel="noreferrer"
                  class="inline-flex items-center gap-3 rounded-full border border-[var(--line)] bg-[var(--surface-soft)] px-4 py-2 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5 hover:border-[var(--line-strong)] hover:bg-[var(--surface)]"
                >
                  View GitHub
                  <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">repos</span>
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <section aria-labelledby="project-signals" class="mt-16 lg:mt-20">
    <div class="flex flex-col gap-6 border-t border-[var(--line-strong)] pt-10 lg:flex-row lg:items-end lg:justify-between lg:pt-12">
      <div>
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent-cool)]">
          Framing
        </p>
        <h2 id="project-signals" class="mt-4 max-w-[9ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
          A clearer way to read the work.
        </h2>
      </div>

      <p class="max-w-xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8 lg:text-right">
        The page is designed to separate finished work, collaborative builds, and archive material without forcing everything into the same visual weight.
      </p>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-3">
      {signals.map((signal) => (
        <article class="rounded-[2rem] border border-[var(--line)] bg-[var(--surface)] p-6 sm:p-8">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--accent)]">
            {signal.label}
          </p>
          <h3 class="mt-8 max-w-[11ch] font-display text-[clamp(2rem,3vw,3rem)] leading-[0.95] tracking-[-0.06em] text-[var(--ink)]">
            {signal.value}
          </h3>
          <p class="mt-4 text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
            {signal.text}
          </p>
        </article>
      ))}
    </div>
  </section>

  <ProjectGrid projects={projects} profileUrl={profileUrl} />

  <section class="mt-20 border-t border-[var(--line-strong)] pt-12 lg:mt-28 lg:pt-16">
    <div class="grid gap-4 lg:grid-cols-2">
      {routes.map((route) => (
        <a
          href={route.href}
          class="group rounded-[2rem] border border-[var(--line)] bg-[var(--surface)] p-6 transition duration-300 hover:-translate-y-1 hover:border-[var(--line-strong)] sm:p-8"
        >
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
            {route.note}
          </p>
          <h2 class="mt-8 max-w-[11ch] font-display text-4xl leading-[0.95] tracking-[-0.06em] text-[var(--ink)] sm:text-5xl">
            {route.title}
          </h2>
          <p class="mt-4 max-w-xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
            {route.text}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
