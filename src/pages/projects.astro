---
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const profileUrl = "https://github.com/AlexCasal?tab=repositories";

const projects = [
  {
    name: "leadquiry",
    title: "LeadQuiry",
    kind: "Lead-generation SaaS",
    summary:
      "A platform that turns scattered business prospecting into a clearer and more organized workflow.",
    sections: [
      {
        label: "What it is",
        text: "A lead-generation product for businesses that need a simpler way to discover and manage potential customers.",
      },
      {
        label: "The problem",
        text: "Prospecting is often spread across searches, spreadsheets, and disconnected tools, making useful leads difficult to track.",
      },
      {
        label: "What it offers",
        text: "Users can find relevant businesses, save leads into collections, keep research organized, and export the results for sales.",
      },
      {
        label: "The team",
        text: "We are a two-person team. I am co-founder and lead product, while my co-founder leads marketing and growth.",
      },
    ],
    githubUrl: null,
    liveUrl: "https://leadquiry.com",
    language: "Full-stack SaaS",
    updatedLabel: "Active",
    status: "Co-founder",
  },
  {
    name: "alexcasal.es",
    title: "alexcasal.es",
    kind: "Personal website",
    summary:
      "A personal portfolio designed to present my work, experience, and current direction without losing personality.",
    sections: [
      {
        label: "The purpose",
        text: "My main professional space: part portfolio, part project archive, and part introduction to how I approach digital products.",
      },
      {
        label: "The previous version",
        text: "A traditional portfolio can feel generic or make recruiters work too hard to understand the person behind the projects.",
      },
      {
        label: "Inside the site",
        text: "A focused view of selected projects, real experiences, ongoing experiments, my background, and clear ways to contact me.",
      },
      {
        label: "Ongoing direction",
        text: "I shape the visual direction, write the content, and evolve the site as my work and professional goals change.",
      },
    ],
    githubUrl: "https://github.com/AlexCasal/alexcasal.es",
    liveUrl: "https://alexcasal.es",
    language: "Astro",
    updatedLabel: "Apr 2026",
    status: "Ongoing",
  },
  {
    name: "zara-challenge",
    title: "Zara Challenge",
    kind: "Technical assessment",
    summary:
      "A technical challenge completed for Inditex: turn smartphone data from an API into a polished, responsive frontend.",
    sections: [
      {
        label: "The challenge",
        text: "The assignment was to create a product catalogue as part of a frontend technical assessment for Inditex.",
      },
      {
        label: "The brief",
        text: "The API provided mobile phones with their images, specifications, and product details—not clothing or fashion items.",
      },
      {
        label: "The experience",
        text: "The interface uses responsive layouts and hover states to reveal and organize each phone's information as requested.",
      },
      {
        label: "The result",
        text: "A polished frontend that turns raw API data into a clear catalogue and preserves the intended behaviour across screen sizes.",
      },
    ],
    githubUrl: "https://github.com/AlexCasal/zara-challenge",
    liveUrl: "https://zara-challenge-rouge.vercel.app",
    language: "React",
    updatedLabel: "Mar 2026",
    status: "Shipped",
  },
  {
    name: "hackudc-2026",
    title: "HackUDC 2026",
    kind: "Event website",
    summary:
      "The public website for a 400+ participant hackathon organized by the GPUL community.",
    sections: [
      {
        label: "The event",
        text: "The official digital home of HackUDC 2026, bringing together the event, programme, sponsors, and practical information.",
      },
      {
        label: "The audience",
        text: "A large technical event needs one reliable place where participants, partners, and visitors can understand what is happening.",
      },
      {
        label: "The website",
        text: "A clear public reference for schedules, participation details, sponsor visibility, updates, and the identity of the event.",
      },
      {
        label: "The collaboration",
        text: "I contributed as part of the web and organizing team, coordinating remotely and supporting public and sponsor-facing communication.",
      },
    ],
    githubUrl: "https://github.com/AlexCasal/hackudc-2026",
    liveUrl: "https://hackudc.gpul.org/",
    language: "Astro",
    updatedLabel: "Jan 2026",
    status: "Collaboration",
  },
  {
    name: "personal-web",
    title: "Personal Web",
    kind: "Earlier iteration",
    summary:
      "An earlier personal website preserved as a snapshot of how my portfolio and visual direction began.",
    sections: [
      {
        label: "First iteration",
        text: "The first complete version of my personal website, created before the current portfolio found its stronger identity and focus.",
      },
      {
        label: "Why it existed",
        text: "I needed a simple online presence where I could introduce myself and begin collecting my work in one place.",
      },
      {
        label: "What it included",
        text: "A straightforward static portfolio with essential navigation, personal context, project links, and a responsive presentation.",
      },
      {
        label: "What came next",
        text: "I designed and developed the full site, using it as the starting point for the portfolio you are viewing now.",
      },
    ],
    githubUrl: "https://github.com/AlexCasal/personal-web",
    liveUrl: null,
    language: "HTML",
    updatedLabel: "Oct 2025",
    status: "Archive",
  },
];
---

<BaseLayout
  title="Alex Casal | Projects"
  description="Selected projects from Alex Casal, full-stack developer and LeadQuiry co-founder in Berlin: SaaS, React, Next.js, Astro, TypeScript, APIs, and responsive web interfaces."
  page="projects"
>
  <section
    class="page-hero relative overflow-hidden border-b border-[var(--line)] pb-16 lg:pb-20"
  >
    <div
      aria-hidden="true"
      class="absolute left-[12%] top-8 h-40 w-40 rounded-full bg-[var(--accent-soft)] blur-3xl"
    >
    </div>

    <div class="grid gap-10 lg:grid-cols-[1.5fr_0.5fr] lg:items-end">
      <div>
        <div class="flex items-center gap-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]"
          >
            Projects / 03
          </p>
          <span class="h-px flex-1 bg-[var(--line)]"></span>
        </div>

        <h1
          class="mt-6 font-display text-[clamp(3.8rem,10vw,8rem)] leading-[0.88] tracking-[-0.08em] text-[var(--ink)] text-shadow-soft"
        >
          Selected work, not a repo dump.
        </h1>

        <div
          class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-[var(--muted)] sm:text-[1.28rem] sm:leading-9"
        >
          <p>
            This page is a curated read of the work, not a mirror of everything
            that happens to live on GitHub. The point is selection, framing, and
            enough context for hiring teams to understand what I built, how I
            think, and what I learned.
          </p>
          <p></p>
          <dd class="mt-9">
            <a
              href={profileUrl}
              target="_blank"
              rel="noreferrer"
              class="accent-button inline-flex items-center gap-3 rounded-full border bg-[var(--surface-soft)] px-4 py-2 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5"
            >
              Do you want to see all my repos?
              <span
                class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]"
                >Here is my GitHub</span
              >
            </a>
          </dd>
        </div>
      </div>
    </div>

    <section aria-labelledby="project-signals" class="mt-16 lg:mt-20">
      <div
        class="accent-panel rounded-[2rem] border border-[var(--line)] p-6 sm:p-8"
      >
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent-cool)]"
        >
          Before you scroll
        </p>
        <h2
          id="project-signals"
          class="mt-5 max-w-[16ch] font-display text-[clamp(2rem,4vw,3.6rem)] leading-[0.95] tracking-[-0.07em] text-[var(--ink)]"
        >
          Selected finished projects.
        </h2>
        <p
          class="mt-4 max-w-3xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8"
        >
          If you want to see work in progress, half-built ideas, and experiments
          that are still evolving, head to the Laboratory section.
        </p>
        <dd class="mt-9">
          <a
            href="/lab"
            target="_blank"
            rel="noreferrer"
            class="accent-button inline-flex items-center gap-3 rounded-full border bg-[var(--surface-soft)] px-4 py-2 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5"
          >
            Do you want to go to the lab?
            <span
              class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]"
              >Here is the Lab</span
            >
          </a>
        </dd>
      </div>
    </section>

    <ProjectGrid projects={projects} profileUrl={profileUrl} />
  </section>
</BaseLayout>
