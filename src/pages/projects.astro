---
import ProjectGrid from "../components/ProjectGrid.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const profileUrl = "https://github.com/AlexCasal?tab=repositories";

const projects = [
  {
    name: "alexcasal.es",
    title: "alexcasal.es",
    kind: "Personal website",
    summary:
      "The site itself: an Astro-based personal internet that tries to behave more like a studio surface than a standard portfolio.",
    githubUrl: "https://github.com/AlexCasal/alexcasal.es",
    liveUrl: null,
    language: "Astro",
    updatedLabel: "Apr 2026",
    status: "Ongoing",
  },
  {
    name: "zara-challenge",
    title: "Zara Challenge",
    kind: "Frontend challenge",
    summary:
      "A retail interface exercise focused on structure, browsing clarity, and translating a familiar product system into a sharper front-end build.",
    githubUrl: "https://github.com/AlexCasal/zara-challenge",
    liveUrl: "https://zara-challenge-rouge.vercel.app",
    language: "JavaScript",
    updatedLabel: "Mar 2026",
    status: "Shipped",
  },
  {
    name: "hackudc-2026",
    title: "HackUDC 2026",
    kind: "Event website",
    summary:
      "The official site for HackUDC 2026. More public-facing, more information-heavy, and built with a stronger collaboration constraint.",
    githubUrl: "https://github.com/AlexCasal/hackudc-2026",
    liveUrl: "https://hackudc.gpul.org/",
    language: "Astro",
    updatedLabel: "Jan 2026",
    status: "Collaboration",
  },
  {
    name: "personal-web",
    title: "Personal Web",
    kind: "Earlier iteration",
    summary:
      "A previous personal website and a useful archive point for how the current direction grew out of something simpler and more conventional.",
    githubUrl: "https://github.com/AlexCasal/personal-web",
    liveUrl: null,
    language: "HTML",
    updatedLabel: "Oct 2025",
    status: "Archive",
  },
];
---

<BaseLayout
  title="Alex Casal | Projects"
  description="Selected projects from Alex Casal: an edited set of websites, interface work, and public builds."
>
  <section
    class="relative overflow-hidden border-b border-[var(--line)] pb-16 lg:pb-20"
  >
    <div
      aria-hidden="true"
      class="absolute left-[12%] top-8 h-40 w-40 rounded-full bg-[var(--accent-soft)] blur-3xl"
    >
    </div>

    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] lg:items-end"
    >
      <div>
        <div class="flex items-center gap-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]"
          >
            Projects / 03
          </p>
          <span class="h-px flex-1 bg-[var(--line)]"></span>
        </div>

        <h1
          class="mt-6 max-w-[8ch] font-display text-[clamp(3.8rem,10vw,8rem)] leading-[0.88] tracking-[-0.08em] text-[var(--ink)] text-shadow-soft"
        >
          Selected work, not a repo dump.
        </h1>

        <div
          class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-[var(--muted)] sm:text-[1.28rem] sm:leading-9"
        >
          <p>
            This page is a curated read of the work, not a mirror of everything
            that happens to live on GitHub. The point is selection, framing, and
            enough context to make the shape of the practice legible.
          </p>
          <p>
            Some projects are more resolved, some are collaborative, and some
            matter because they show an earlier version of the same line of
            thinking. They do not need identical treatment to belong together.
          </p>
        </div>
        <dd class="mt-9">
          <a
            href={profileUrl}
            target="_blank"
            rel="noreferrer"
            class="inline-flex items-center gap-3 rounded-full border border-[var(--line)] bg-[var(--surface-soft)] px-4 py-2 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5 hover:border-[var(--line-strong)] hover:bg-[var(--surface)]"
          >
            Do you want to see al my repos?
            <span
              class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]"
              >Here is my GitHub</span
            >
          </a>
        </dd>
      </div>
    </div>
  </section>

  <section aria-labelledby="project-signals" class="mt-16 lg:mt-20">
    <div
      class="rounded-[2rem] border border-[var(--line)] bg-[var(--surface)] p-6 sm:p-8"
    >
      <p
        class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent-cool)]"
      >
        Before you scroll
      </p>
      <h2
        id="project-signals"
        class="mt-5 max-w-[16ch] font-display text-[clamp(2rem,4vw,3.6rem)] leading-[0.95] tracking-[-0.07em] text-[var(--ink)]"
      >
        Here you will only see projects I consider finished.
      </h2>
      <p
        class="mt-4 max-w-3xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8"
      >
        If you want to see work in progress, half-built ideas, and experiments
        that are still evolving, head to the Laboratory section.
      </p>
      <dd class="mt-9">
        <a
          href="/lab"
          target="_blank"
          rel="noreferrer"
          class="inline-flex items-center gap-3 rounded-full border border-[var(--line)] bg-[var(--surface-soft)] px-4 py-2 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5 hover:border-[var(--line-strong)] hover:bg-[var(--surface)]"
        >
          Do you want to go to the lab?
          <span
            class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]"
            >Here is the Lab</span
          >
        </a>
      </dd>
    </div>
  </section>

  <ProjectGrid projects={projects} profileUrl={profileUrl} />
</BaseLayout>
