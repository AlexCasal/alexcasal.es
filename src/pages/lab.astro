---
import BaseLayout from "../layouts/BaseLayout.astro";

const routes = [
  {
    href: "/projects",
    note: "Available now",
    title: "See the resolved work in Projects.",
  },
  {
    href: "/experiences",
    note: "Also coming soon",
    title: "Follow the journey in Experiences.",
  },
];

const labProjects = [
  {
    name: "leadquiry-lab",
    title: "LeadQuiry",
    status: "Always evolving",
    kind: "Live product lab",
    summary:
      "A real SaaS product that keeps changing as we refine how businesses discover, organize, and work with potential customers.",
    description:
      "This is the experimental side of LeadQuiry: the place where product decisions become new workflows, clearer interactions, and better ways to move from a search to a useful collection of leads.",
    detail:
      "Because the product is active, the lab never has a final version. Each iteration tests how the experience can become simpler without losing the depth a serious lead-generation tool needs.",
    tags: ["Product", "Lead generation", "UX", "SaaS", "Active development"],
    focus: [
      { label: "Product", text: "Turning real prospecting needs into focused features." },
      { label: "Flow", text: "Reducing friction between search, collection, and export." },
      { label: "Business", text: "Balancing useful results with a sustainable product model." },
    ],
    action: {
      href: "https://leadquiry.com",
      label: "Visit LeadQuiry",
      detail: "Live product",
    },
  },
  {
    name: "devnotes-lab",
    title: "DevNotes Lab",
    status: "In progress",
    kind: "Developer notes",
    summary:
      "A small developer notes lab for tutorials, experiments, and technical posts that I want to keep, share, or improve over time.",
    description:
      "DevNotes Lab is a lightweight project for publishing technical notes, tutorials, and small development experiments without adding unnecessary complexity. Posts live directly in the codebase instead of a database, which keeps the project simple to maintain, version, and improve through GitHub pull requests.",
    detail:
      "It is meant to collect setup guides, developer workflows, useful commands, small experiments, and notes about tools I use while building software.",
    tags: ["Astro", "TypeScript", "Markdown", "GitHub", "Developer Tools"],
    focus: [
      { label: "Notes", text: "Keeping useful technical discoveries easy to revisit." },
      { label: "Workflow", text: "Turning repeated setup work into reusable guidance." },
      { label: "Iteration", text: "Improving each entry as the tools and projects evolve." },
    ],
    action: {
      href: "https://github.com/AlexCasal/devnotes-lab",
      label: "GitHub",
      detail: "Repo",
    },
  },
];
---

<BaseLayout
  title="Alex Casal | Lab"
  description="Lab page for experiments, prototypes, and unfinished interaction studies."
  page="lab"
>
  <section
    class="page-hero relative overflow-hidden border-[var(--line)] pb-16 lg:pb-20"
  >
    <div
      aria-hidden="true"
      class="absolute left-[10%] top-8 h-40 w-40 rounded-full bg-[var(--accent-soft)] blur-3xl"
    >
    </div>

    <div class="grid gap-10 lg:grid-cols-[1.5fr_0.5fr] lg:items-end">
      <div>
        <div class="flex items-center gap-4">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]"
          >
            Lab / 04
          </p>
          <span class="h-px flex-1 bg-[var(--line)]"></span>
        </div>

        <h1
          class="mt-6 font-display text-[clamp(3.8rem,10vw,8rem)] leading-[0.88] tracking-[-0.08em] text-[var(--ink)] text-shadow-soft"
        >
          The lab is starting to open.
        </h1>

        <div
          class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-[var(--muted)] sm:text-[1.28rem] sm:leading-9"
        >
          <p>
            This section is reserved for experiments, unfinished prototypes, and
            pieces that are still in motion.
          </p>
          <p>
            Instead of shipping everything at once, I am preparing the lab as a
            stream of smaller releases that can stay rough without becoming
            messy.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section aria-labelledby="lab-projects" class="mt-20 lg:mt-28">
    <div
      class="accent-divider flex flex-col gap-5 border-t pt-8 sm:flex-row sm:items-end sm:justify-between"
    >
      <div>
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent-cool)]"
        >
          Laboratory projects
        </p>
        <h2
          id="lab-projects"
          class="mt-4 max-w-[11ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl"
        >
          Notes, tests, and useful little builds.
        </h2>
      </div>
      <p class="max-w-md text-base leading-7 text-[var(--muted)]">
        Smaller projects can stay flexible here while they are still becoming
        something clearer.
      </p>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-2">
      {
        labProjects.map((project) => (
          <article
            id={project.name}
            class="accent-card group rounded-[2rem] border border-[var(--line)] p-6 sm:p-8"
          >
            <div class="flex flex-wrap items-center justify-between gap-4">
              <div>
                <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--accent)]">
                  {project.status}
                </p>
                <p class="mt-2 font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">
                  {project.kind}
                </p>
              </div>
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">
                #{project.name}
              </span>
            </div>

            <h3 class="mt-10 max-w-[9ch] font-display text-[clamp(2.45rem,6vw,4.8rem)] leading-[0.92] tracking-[-0.07em] text-[var(--ink)] transition duration-300 group-hover:text-[var(--accent-strong)]">
              {project.title}
            </h3>
            <p class="mt-5 max-w-3xl text-lg leading-8 text-[var(--muted)]">
              {project.summary}
            </p>
            <p class="mt-5 max-w-3xl text-base leading-7 text-[var(--muted)]">
              {project.description}
            </p>
            <p class="mt-4 max-w-3xl text-base leading-7 text-[var(--soft)]">
              {project.detail}
            </p>

            <div class="mt-7 flex flex-wrap gap-2">
              {project.tags.map((tag) => (
                <span class="accent-pill rounded-full border px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.18em]">
                  {tag}
                </span>
              ))}
            </div>

            {project.focus.length > 0 && (
              <dl class="mt-7 grid gap-4 border-t border-[var(--line)] pt-6 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
                {project.focus.map((item) => (
                  <div>
                    <dt class="font-mono text-[0.64rem] uppercase tracking-[0.22em] text-[var(--accent-cool)]">
                      {item.label}
                    </dt>
                    <dd class="mt-2 text-sm leading-6 text-[var(--muted)]">
                      {item.text}
                    </dd>
                  </div>
                ))}
              </dl>
            )}

            <div class="mt-8 flex flex-wrap gap-3 border-t border-[var(--line)] pt-5">
              <a
                href={project.action.href}
                target="_blank"
                rel="noreferrer"
                class="accent-button inline-flex items-center gap-3 rounded-full border bg-[var(--surface-soft)] px-5 py-3 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5"
              >
                {project.action.label}
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                  {project.action.detail}
                </span>
              </a>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="mt-20 lg:mt-28">
    <div class="grid gap-4 lg:grid-cols-2">
      {
        routes.map((route) => (
          <a
            href={route.href}
            class="accent-card group rounded-[2rem] border border-[var(--line)] p-6 sm:p-8"
          >
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
              {route.note}
            </p>
            <h3 class="mt-8 max-w-[11ch] font-display text-4xl leading-[0.95] tracking-[-0.06em] text-[var(--ink)] sm:text-5xl">
              {route.title}
            </h3>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
