---
import BaseLayout from "../layouts/BaseLayout.astro";

const contactChannels = [
  {
    title: "Email",
    href: "mailto:alexcasaldaw@gmail.com?subject=Developer%20role%20opportunity",
    note: "alexcasaldaw@gmail.com",
  },
  {
    title: "LinkedIn",
    href: "https://www.linkedin.com/in/alexcasaldaw/",
    note: "Professional profile, role context, and messages",
  },
  {
    title: "GitHub",
    href: "https://github.com/AlexCasal",
    note: "Code, projects, experiments, and public work",
  },
  {
    title: "Download CV",
    href: "/docs/CV_Alex.pdf",
    note: "PDF CV for hiring processes",
  },
];
---

<BaseLayout
  title="Alex Casal - Contact"
  description="Contact Alex Casal, junior full-stack software developer based in Berlin, open to interviews for developer roles."
>
  <section class="relative overflow-hidden border-[var(--line)] pb-16 lg:pb-20">
    <div aria-hidden="true" class="absolute right-[8%] top-8 h-40 w-40 rounded-full bg-[var(--accent-soft)] blur-3xl"></div>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)] lg:items-end">
      <div>
        <div class="flex items-center gap-4">
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]">
            Contact / 06
          </p>
          <span class="h-px flex-1 bg-[var(--line)]"></span>
        </div>

        <h1 class="mt-6 max-w-[10ch] font-display text-[clamp(3.8rem,10vw,8rem)] leading-[0.88] tracking-[-0.08em] text-[var(--ink)] text-shadow-soft">
          Interested in working together?
        </h1>

        <div class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-[var(--muted)] sm:text-[1.28rem] sm:leading-9">
          <p>
            I am currently looking for a junior developer role in Berlin,
            especially in full-stack teams building real products.
          </p>
          <p>
            If you are hiring or think my profile could fit your team, feel free
            to contact me. I usually reply within 24-48 hours.
          </p>
        </div>

        <div class="mt-10 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a
            href="mailto:alexcasaldaw@gmail.com?subject=Developer%20role%20opportunity"
            class="inline-flex items-center gap-3 rounded-full bg-[var(--accent)] px-5 py-3 text-sm text-[#0b0d10] transition duration-300 hover:-translate-y-0.5 hover:bg-[var(--accent-strong)]"
          >
            Email me
          </a>
          <a
            href="/docs/CV_Alex.pdf"
            download
            class="accent-button inline-flex items-center gap-3 rounded-full border bg-[var(--surface-soft)] px-5 py-3 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5"
          >
            Download CV
            <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">PDF</span>
          </a>
        </div>
      </div>

      <aside class="lg:pb-2">
        <div class="rounded-[2rem] border border-[var(--line)] bg-[linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.01))] p-6 sm:p-8">
          <p class="font-mono uppercase tracking-[0.28em] text-[var(--accent-cool)]">
            Hiring details
          </p>

          <dl class="mt-6 space-y-5">
            <div class="border-t border-[var(--line)] pt-5 first:border-t-0 first:pt-0">
              <dt class="font-mono text-[0.9rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                Availability
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                Open to interviews for junior full-stack and software developer roles.
              </dd>
            </div>

            <div class="border-t border-[var(--line)] pt-5">
              <dt class="font-mono text-[0.9rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                Location
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                Berlin, Germany. Open to Berlin onsite, Berlin hybrid, or remote EU.
              </dd>
            </div>

            <div class="border-t border-[var(--line)] pt-5">
              <dt class="font-mono text-[0.9rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                Response
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                I usually reply within 24-48 hours.
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <section aria-labelledby="channels" class="mt-20 border-t border-[var(--line-strong)] pt-12 lg:mt-28 lg:pt-16">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent-cool)]">
          Channels
        </p>
        <h2 id="channels" class="mt-4 max-w-[10ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
          Easy ways to reach me.
        </h2>
      </div>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-4">
      {contactChannels.map((channel) => (
        <a
          href={channel.href}
          target={channel.href.startsWith("http") ? "_blank" : undefined}
          rel={channel.href.startsWith("http") ? "noreferrer" : undefined}
          download={channel.href.endsWith(".pdf") ? true : undefined}
          class="group rounded-[2rem] border border-[var(--line)] bg-[var(--surface)] p-6 transition duration-300 hover:-translate-y-1 hover:border-[var(--line-strong)] sm:p-8"
        >
          <p class="font-mono text-[0.9rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
            {channel.title}
          </p>
          <p class="mt-4 text-base leading-7 sm:text-lg sm:leading-8">
            {channel.note}
          </p>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
