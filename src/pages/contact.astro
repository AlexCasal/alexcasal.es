---
import BaseLayout from "../layouts/BaseLayout.astro";

const contactChannels = [
  {
    title: "Email",
    value: "hello@alexcasal.com",
    href: "mailto:hello@alexcasal.com",
    note: "Best for collaborations and project briefs",
  },
  {
    title: "LinkedIn",
    value: "alex-casal",
    href: "https://www.linkedin.com",
    note: "For professional context and intros",
  },
  {
    title: "GitHub",
    value: "alexcasal",
    href: "https://github.com",
    note: "Code, experiments, and open work",
  },
];

const collaborationTypes = [
  {
    title: "Websites with stronger editorial direction",
    text: "Personal brands, studio sites, and product pages that need more clarity, rhythm, and point of view than a standard template.",
    tag: "design + build",
  },
  {
    title: "Frontend systems and reusable structures",
    text: "Design systems, component architectures, and page frameworks that keep consistency without slowing down iteration.",
    tag: "systems",
  },
  {
    title: "Experiments and interface studies",
    text: "Prototype work focused on motion restraint, typography, and interaction patterns that feel current without being noisy.",
    tag: "lab work",
  },
];
---

<BaseLayout
  title="Alex Casal | Contact"
  description="Get in touch with Alex Casal for collaborations, commissions, and web projects with a clear editorial point of view."
>
  <section class="relative overflow-hidden border-b border-[var(--line)] pb-16 lg:pb-20">
    <div aria-hidden="true" class="absolute right-[8%] top-8 h-40 w-40 rounded-full bg-[var(--accent-soft)] blur-3xl"></div>

    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(18rem,0.8fr)] lg:items-end">
      <div>
        <div class="flex items-center gap-4">
          <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]">
            Contact / 06
          </p>
          <span class="h-px flex-1 bg-[var(--line)]"></span>
        </div>

        <h1 class="mt-6 max-w-[10ch] font-display text-[clamp(3.8rem,10vw,8rem)] leading-[0.88] tracking-[-0.08em] text-[var(--ink)] text-shadow-soft">
          Let us build something with intention.
        </h1>

        <div class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-[var(--muted)] sm:text-[1.28rem] sm:leading-9">
          <p>
            If you are planning a site, rethinking a digital presence, or exploring a more authored web format, this is the right place to start.
          </p>
          <p>
            Share where you are, what you are trying to improve, and the timeline you have in mind. I can usually reply within a few days.
          </p>
        </div>

        <a
          href="mailto:hello@alexcasal.com?subject=New%20project%20inquiry"
          class="mt-10 inline-flex items-center gap-3 rounded-full bg-[var(--accent)] px-5 py-3 text-sm text-[#0b0d10] transition duration-300 hover:-translate-y-0.5 hover:bg-[var(--accent-strong)]"
        >
          Start with email
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[#0b0d10]/65">hello@alexcasal.com</span>
        </a>
      </div>

      <aside class="lg:pb-2">
        <div class="rounded-[2rem] border border-[var(--line)] bg-[linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.01))] p-6 sm:p-8">
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.28em] text-[var(--accent-cool)]">
            Contact notes
          </p>

          <dl class="mt-6 space-y-5">
            <div class="border-t border-[var(--line)] pt-5 first:border-t-0 first:pt-0">
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                Availability
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                Open for selected collaborations and scoped freelance work.
              </dd>
            </div>

            <div class="border-t border-[var(--line)] pt-5">
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                Typical response
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                Usually within 2-4 business days.
              </dd>
            </div>

            <div class="border-t border-[var(--line)] pt-5">
              <dt class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                Location
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                Berlin, working remotely and asynchronously.
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <section aria-labelledby="channels" class="mt-20 border-t border-[var(--line-strong)] pt-12 lg:mt-28 lg:pt-16">
    <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
      <div>
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent-cool)]">
          Channels
        </p>
        <h2 id="channels" class="mt-4 max-w-[10ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
          Pick the route that fits.
        </h2>
      </div>
    </div>

    <div class="mt-8 grid gap-4 lg:grid-cols-3">
      {contactChannels.map((channel) => (
        <a
          href={channel.href}
          target={channel.href.startsWith("http") ? "_blank" : undefined}
          rel={channel.href.startsWith("http") ? "noreferrer" : undefined}
          class="group rounded-[2rem] border border-[var(--line)] bg-[var(--surface)] p-6 transition duration-300 hover:-translate-y-1 hover:border-[var(--line-strong)] sm:p-8"
        >
          <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
            {channel.title}
          </p>
          <h3 class="mt-8 break-words font-display text-3xl leading-[0.95] tracking-[-0.06em] text-[var(--ink)] sm:text-4xl">
            {channel.value}
          </h3>
          <p class="mt-4 text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
            {channel.note}
          </p>
        </a>
      ))}
    </div>
  </section>

  <section aria-labelledby="collaboration" class="mt-20 border-t border-[var(--line-strong)] pt-12 lg:mt-28 lg:pt-16">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:gap-14">
      <div>
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]">
          Collaboration
        </p>
        <h2 id="collaboration" class="mt-4 max-w-[11ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
          Projects that are a good fit.
        </h2>
      </div>

      <div class="border-t border-[var(--line-strong)]">
        {collaborationTypes.map((item, index) => (
          <article class="grid gap-5 border-b border-[var(--line)] py-8 transition duration-300 hover:border-[var(--line-strong)] lg:grid-cols-[4.5rem_minmax(0,1fr)_auto] lg:items-start lg:gap-8">
            <span class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[var(--soft)]">
              {String(index + 1).padStart(2, "0")}
            </span>
            <div>
              <h3 class="font-display text-[clamp(1.8rem,2.9vw,3rem)] leading-[0.95] tracking-[-0.06em] text-[var(--ink)]">
                {item.title}
              </h3>
              <p class="mt-4 max-w-2xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
                {item.text}
              </p>
            </div>
            <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)] lg:pt-2">
              {item.tag}
            </span>
          </article>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
