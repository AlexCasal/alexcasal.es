---
import BaseLayout from "../layouts/BaseLayout.astro";

const routes = [
  {
    title: "Projects",
    href: "/projects",
    text: "Selected work with problem, build, stack, and learning notes for hiring teams.",
    note: "Built work",
  },
  {
    title: "Experiences",
    href: "/experiences",
    text: "Community work, events, teamwork, communication, and the situations that shaped how I work.",
    note: "Experience",
  },
  {
    title: "Contact",
    href: "/contact",
    text: "For developer roles, team conversations, interviews, and professional context.",
    note: "Hiring",
  },
];

const stackGroups = [
  {
    title: "Main stack",
    text: "The tools I use most for building clear, responsive interfaces and portfolio-ready web applications.",
    tools: ["React", "Astro", "JavaScript", "TypeScript", "HTML", "CSS", "Tailwind"],
  },
  {
    title: "Backend basics",
    text: "The server-side fundamentals I use to understand how products work beyond the interface.",
    tools: ["Node.js", "Express", "REST APIs", "SQL", "PHP", "Laravel"],
  },
  {
    title: "Tools",
    text: "The practical tooling I use to build, version, deploy, and keep projects moving.",
    tools: ["Git", "GitHub", "Docker", "Linux", "Vercel", "GitHub Actions"],
  },
  {
    title: "Also explored",
    text: "Areas I have touched through projects, experiments, community work, and AI-assisted workflows.",
    tools: ["Angular", "Flutter", "AI-assisted workflows"],
  },
];
---

<BaseLayout
  title="Alex Casal - About"
  description="About Alex Casal, a junior full-stack software developer based in Berlin, working with React, Astro, JavaScript, TypeScript, Node.js and SQL."
  page="about"
>
  <section
    class="page-hero relative overflow-hidden border-b border-[var(--line)] pb-16 lg:pb-20"
  >
    <div
      aria-hidden="true"
      class="absolute left-[8%] top-10 h-40 w-40 rounded-full bg-[var(--accent-soft)] blur-3xl"
    >
    </div>
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] lg:items-end"
    >
      <div>
        <div class="flex items-center gap-4">
          <p
            class="font-mono text-[0.8rem] uppercase tracking-[0.3em] text-[var(--accent)]"
          >
            About / 02
          </p>
          <span class="h-px flex-1 bg-[var(--line)]"></span>
        </div>
        <h1
          class="mt-6 max-w-[10ch] font-display text-[clamp(3.8rem,10vw,8rem)] leading-[0.88] tracking-[-0.08em] text-[var(--ink)] text-shadow-soft"
        >
          About me, but useful.
        </h1>
        <div
          class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-[var(--muted)] sm:text-[1.28rem] sm:leading-9"
        >
          <p>
            I am a junior full-stack software developer based in Berlin. I
            work mainly with React, Astro, JavaScript, TypeScript, Node.js and
            SQL. I enjoy building clear interfaces, understanding how products
            work end-to-end, and using AI-assisted workflows to prototype and
            solve problems faster.
          </p>

          <p>
            This is less a biography than a small orientation. Part portfolio,
            part working surface, it is meant to feel closer to a working
            surface than a traditional portfolio.
          </p>
        </div>
      </div>
      <aside class="lg:pb-2">
        <div
          class="accent-panel rounded-[2rem] border border-[var(--line)] p-6 sm:p-8"
        >
          <p
            class="font-mono uppercase tracking-[0.28em] text-[var(--accent-cool)]"
          >
            Snapshot
          </p>
          <dl class="mt-6 space-y-5">
            <div
              class="border-t border-[var(--line)] pt-5 first:border-t-0 first:pt-0"
            >
              <dt
                class="font-mono text-[0.9rem] uppercase tracking-[0.24em] text-[var(--soft)]"
              >
                Base
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                Originally from Spain, now based in Berlin and open to junior
                full-stack and software developer roles.
              </dd>
            </div>
            <div class="border-t border-[var(--line)] pt-5">
              <dt
                class="font-mono text-[0.9rem] uppercase tracking-[0.24em] text-[var(--soft)]"
              >
                Focus
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                Building clear interfaces, reusable components, responsive
                layouts, and product features that are easy to understand.
              </dd>
            </div>
            <div class="border-t border-[var(--line)] pt-5">
              <dt
                class="font-mono text-[0.9rem] uppercase tracking-[0.24em] text-[var(--soft)]"
              >
                Languages
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                Spanish and English 
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </section>

  <section aria-labelledby="a-bit-more" class="mt-20 pt-12 lg:mt-10 lg:pt-10">
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-14"
    >
      <div>
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]"
        >
          A bit more
        </p>
        <h2
          id="a-bit-more"
          class="mt-4 max-w-[10ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl"
        >
          Short version about me.
        </h2>
      </div>
      <div
        class="space-y-5 text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8"
      >
        <p>
          I enjoy learning and building things to understand how they work. Over
          time, that evolved into a strong interest in creating clean,
          efficient, and intentional digital experiences.
        </p>

        <p>
          I am part of the GPUL community, where I have been surrounded by
          people who genuinely enjoy technology, open source, and sharing
          knowledge. I have also contributed to organizing HackUDC, an
          experience that reinforced how much I enjoy collaborative environments
          and solving problems with others.
        </p>

        <p>
          I like finding efficient ways to solve problems, especially by
          combining good design, solid structure, and AI-assisted workflows. I
          use AI to automate repetitive tasks, prototype ideas faster, and focus
          more energy on the parts of development that require creativity and
          decision making.
        </p>

        <p>
          Right now, I am focused on growing as a developer, building projects
          that feel thoughtful and polished, and finding a team where I can
          continue learning while contributing to meaningful products.
        </p>
      </div>
    </div>
  </section>

  <section
    aria-labelledby="why-berlin"
    class="accent-divider mt-20 border-t pt-12 lg:mt-28 lg:pt-16"
  >
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1.38fr)] lg:gap-14"
    >
      <div>
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]"
        >
          Berlin / next step
        </p>
        <h2
          id="why-berlin"
          class="mt-4 max-w-[10ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl"
        >
          What I am looking for.
        </h2>
      </div>
      <p class="max-w-3xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
        I recently moved to Berlin to grow as a developer and join a
        product-focused team. I am especially interested in startups, developer
        tools, SaaS products, e-commerce, creative technology, and teams where I
        can learn fast while contributing to real features.
      </p>
    </div>
  </section>

  <section
    aria-labelledby="how-i-build"
    class="accent-divider mt-20 border-t pt-12 lg:mt-28 lg:pt-16"
  >
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1.38fr)] lg:gap-14"
    >
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]"
        >
          How I build
        </p>
        <h2
          id="how-i-build"
          class="mt-4 max-w-[9ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl"
        >
          The stack I use to ship.
        </h2>
        <p class="mt-6 max-w-md text-base leading-7 text-[var(--muted)]">
          I like understanding the full path of a product: the interface, the
          backend behind it, the tooling that runs it, and the workflow that
          keeps the work moving.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          stackGroups.map((group) => (
            <article class="accent-card rounded-[2rem] border border-[var(--line)] p-6 sm:p-8">
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--accent-cool)]">
                {group.title}
              </p>
              <p class="mt-5 text-base leading-7 text-[var(--muted)]">
                {group.text}
              </p>
              <div class="mt-6 flex flex-wrap gap-2">
                {group.tools.map((tool) => (
                  <span class="accent-pill rounded-full border px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.18em]">
                    {tool}
                  </span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mt-20 lg:mt-28">
    <div class="grid gap-4 lg:grid-cols-3">
      {
        routes.map((route) => (
          <a
            href={route.href}
            class="accent-card group rounded-[2rem] border border-[var(--line)] p-6 sm:p-8"
          >
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
              {route.note}
            </p>
            <h3 class="mt-8 font-display text-4xl leading-[0.95] tracking-[-0.06em] text-[var(--ink)] sm:text-5xl">
              {route.title}
            </h3>
            <p class="mt-4 text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
              {route.text}
            </p>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
