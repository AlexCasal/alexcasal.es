---
import BaseLayout from "../layouts/BaseLayout.astro";

const routes = [
  {
    title: "Projects",
    href: "/projects",
    text: "Selected work, case-study framing, and the more resolved side of the practice.",
    note: "Built work",
  },
  {
    title: "Experiences",
    href: "/experiences",
    text: "Short post-style reflections about what I am building, learning, and seeing while working in tech.",
    note: "Posts",
  },
  {
    title: "Contact",
    href: "/contact",
    text: "For collaborations, commissions, or conversations about web work with a stronger point of view.",
    note: "Say hello",
  },
];

const stackGroups = [
  {
    title: "Frontend",
    text: "The part of the stack where I feel most at home: interfaces, components, layouts, interaction, and the small details that make a product feel clear.",
    tools: ["Astro", "React", "TypeScript", "JavaScript", "HTML", "CSS", "TailWind CSS"],
  },
  {
    title: "Backend",
    text: "I build the server-side pieces needed to support real products: APIs, data flows, authentication, integrations, and simple services that stay understandable.",
    tools: ["Node.js", "Express", "REST APIs", "PHP", "Laravel", "SQL"],
  },
  {
    title: "Mobile & Web",
    text: "I like building experiences that work across screens, from responsive websites to mobile-friendly interfaces and app-like flows.",
    tools: ["Responsive UI", "Flutter", "Angular",],
  },
  {
    title: "Infra",
    text: "I care about how projects run after the code is written: deployments, environments, containers, domains, and the practical operations around a site.",
    tools: ["Docker", "Linux", "Vercel", "GitHub Pages"],
  },
  {
    title: "Automation",
    text: "I use scripts and tooling to remove repetitive work, connect systems, and make development workflows faster and less fragile.",
    tools: ["GitHub Actions", "Shell", "npm scripts", "CI/CD", "Webhooks"],
  },
  {
    title: "AI assisted",
    text: "I use AI as part of my workflow to prototype faster, review ideas, automate repetitive tasks, and explore solutions before deciding what to build.",
    tools: ["Prompting", "Code review", "Rapid prototyping", "Research", "Task automation"],
  },
];
---

<BaseLayout title="Alex Casal | About" page="about">
  <section
    class="page-hero relative overflow-hidden border-b border-[var(--line)] pb-16 lg:pb-20"
  >
    <div
      aria-hidden="true"
      class="absolute left-[8%] top-10 h-40 w-40 rounded-full bg-[var(--accent-soft)] blur-3xl"
    >
    </div>
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] lg:items-end"
    >
      <div>
        <div class="flex items-center gap-4">
          <p
            class="font-mono text-[0.8rem] uppercase tracking-[0.3em] text-[var(--accent)]"
          >
            About / 02
          </p>
          <span class="h-px flex-1 bg-[var(--line)]"></span>
        </div>
        <h1
          class="mt-6 max-w-[10ch] font-display text-[clamp(3.8rem,10vw,8rem)] leading-[0.88] tracking-[-0.08em] text-[var(--ink)] text-shadow-soft"
        >
          An 'about' page. Yes, apparently I needed one.
        </h1>
        <div
          class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-[var(--muted)] sm:text-[1.28rem] sm:leading-9"
        >
          <p>
            I’m Alex, a frontend developer from Spain, now building a new
            chapter in Berlin. I care about making things that feel clear,
            useful, and well considered.
          </p>

          <p>
            This is less a biography than a small orientation. Part portfolio,
            part working surface, a place that reflects how I think, what I’m
            exploring, and how I approach the web.
          </p>
        </div>
      </div>
      <aside class="lg:pb-2">
        <div
          class="accent-panel rounded-[2rem] border border-[var(--line)] p-6 sm:p-8"
        >
          <p
            class="font-mono uppercase tracking-[0.28em] text-[var(--accent-cool)]"
          >
            Snapshot
          </p>
          <dl class="mt-6 space-y-5">
            <div
              class="border-t border-[var(--line)] pt-5 first:border-t-0 first:pt-0"
            >
              <dt
                class="font-mono text-[0.9rem] uppercase tracking-[0.24em] text-[var(--soft)]"
              >
                Base
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                Originally from Spain, currently relocating to Berlin while
                growing through independent projects and new opportunities.
              </dd>
            </div>
            <div class="border-t border-[var(--line)] pt-5">
              <dt
                class="font-mono text-[0.9rem] uppercase tracking-[0.24em] text-[var(--soft)]"
              >
                Curiosity
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                Interested in the space where design, development, and
                experimentation meet — especially when ideas can turn into
                practical products.
              </dd>
            </div>
            <div class="border-t border-[var(--line)] pt-5">
              <dt
                class="font-mono text-[0.9rem] uppercase tracking-[0.24em] text-[var(--soft)]"
              >
                Open Source
              </dt>
              <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
                Learning through open-source, studying how others build, and
                increasingly using AI to automate tasks and make development
                faster.
              </dd>
            </div>
          </dl>
        </div>
      </aside>
    </div>
  </section>
  <section aria-labelledby="a-bit-more" class="mt-20 pt-12 lg:mt-10 lg:pt-10">
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,0.7fr)_minmax(0,1.3fr)] lg:gap-14"
    >
      <div>
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]"
        >
          A bit more
        </p>
        <h2
          id="a-bit-more"
          class="mt-4 max-w-[10ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl"
        >
          Short version about me.
        </h2>
      </div>
      <div
        class="space-y-5 text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8"
      >
        <p>
          I enjoy learning, and building things to understand how they work.
          Over time, that evolved into a strong interest in creating clean,
          efficient, and intentional digital experiences.
        </p>

        <p>
          I’m part of the GPUL community, where I’ve been surrounded by people
          who genuinely enjoy technology, open source, and sharing knowledge.
          I’ve also contributed to organizing HackUDC, an experience that
          reinforced how much I enjoy collaborative environments and solving
          problems with others.
        </p>

        <p>
          I like finding efficient ways to solve problems, especially by
          combining good design, solid structure, and AI-assisted workflows. I
          usually use AI to automate repetitive tasks, prototype ideas faster,
          and focus more energy on the parts of development that require
          creativity and decision making.
        </p>

        <p>
          Right now, I’m focused on growing as a developer, building projects
          that feel thoughtful and polished, and finding opportunities where I
          can continue learning while contributing to meaningful products and
          teams.
        </p>
      </div>
    </div>
  </section>

  <section
    aria-labelledby="how-i-build"
    class="accent-divider mt-20 border-t pt-12 lg:mt-28 lg:pt-16"
  >
    <div
      class="grid gap-10 lg:grid-cols-[minmax(0,0.62fr)_minmax(0,1.38fr)] lg:gap-14"
    >
      <div class="lg:sticky lg:top-32 lg:self-start">
        <p
          class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]"
        >
          How I build
        </p>
        <h2
          id="how-i-build"
          class="mt-4 max-w-[9ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl"
        >
          The stack I use to ship.
        </h2>
        <p class="mt-6 max-w-md text-base leading-7 text-[var(--muted)]">
          I like understanding the full path of a product: the interface, the
          backend behind it, the infrastructure that runs it, and the automation
          that keeps the work moving.
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {
          stackGroups.map((group) => (
            <article class="accent-card rounded-[2rem] border border-[var(--line)] p-6 sm:p-8">
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--accent-cool)]">
                {group.title}
              </p>
              <p class="mt-5 text-base leading-7 text-[var(--muted)]">
                {group.text}
              </p>
              <div class="mt-6 flex flex-wrap gap-2">
                {group.tools.map((tool) => (
                  <span class="accent-pill rounded-full border px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.18em]">
                    {tool}
                  </span>
                ))}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="mt-20 lg:mt-28">
    <div class="grid gap-4 lg:grid-cols-3">
      {
        routes.map((route) => (
          <a
            href={route.href}
            class="accent-card group rounded-[2rem] border border-[var(--line)] p-6 sm:p-8"
          >
            {" "}
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
              {" "}
              {route.note}{" "}
            </p>{" "}
            <h3 class="mt-8 font-display text-4xl leading-[0.95] tracking-[-0.06em] text-[var(--ink)] sm:text-5xl">
              {" "}
              {route.title}{" "}
            </h3>{" "}
            <p class="mt-4 text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
              {" "}
              {route.text}{" "}
            </p>{" "}
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
