---
import BaseLayout from "../layouts/BaseLayout.astro";
import ComingSoon from "../components/ComingSoon.astro";

const bullets = [
  "Short essays and field notes about interface systems, typography, and information architecture.",
  "Process logs that connect finished projects with the decisions and references behind them.",
  "A digital garden structure ready for future MD/MDX entries and cross-linking.",
];

const routes = [
  {
    href: "/about",
    note: "Context",
    title: "Read the broader practice in About.",
  },
  {
    href: "/contact",
    note: "Say hello",
    title: "Start a conversation while Notes is in progress.",
  },
];
---

<BaseLayout
  title="Alex Casal | Notes"
  description="Notes page for writing, fragments, and digital garden entries coming in the next few months."
>
  <ComingSoon
    eyebrow="Notes / 05"
    title="Notes are being prepared."
    intro="This will become the writing surface of the site: essays, fragments, references, and connected thoughts."
    note="The goal is a calm digital garden with clear structure, where new entries can grow over time without turning into a blog feed dump."
    statusLabel="Build state"
    statusValue="Content model is outlined and the first entries are in draft."
    launchLabel="Launch window"
    launchValue="Initial notes planned for August 2026."
    cadenceLabel="Publishing cadence"
    cadenceValue="One to two thoughtful entries per month after launch."
    bullets={bullets}
    routes={routes}
  />
</BaseLayout>
