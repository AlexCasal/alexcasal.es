---
const pathname = Astro.url.pathname.replace(/\/+$/, "") || "/";

const links = [
  { href: "/", label: "Home", accent: "home" },
  { href: "/about", label: "About", accent: "about" },
  { href: "/projects", label: "Projects", accent: "projects" },
  { href: "/lab", label: "Lab", accent: "lab" },
  { href: "/experiences", label: "Experiences", accent: "experiences" },
  { href: "/contact", label: "Contact", accent: "contact" },
];

const isActive = (href: string) => pathname === href;
---

<header class="sticky top-0 z-50 pt-4 sm:pt-6">
  <div class="rounded-[1.75rem] border border-[var(--line)] bg-[rgba(8,10,12,0.72)] backdrop-blur-2xl">
    <div class="flex items-center justify-between gap-5 px-4 py-4 sm:px-6">
      <a href="/" class="group min-w-0">
        <span class="font-mono text-[0.7rem] uppercase tracking-[0.32em] text-[var(--accent)] transition duration-300 group-hover:text-[var(--accent-strong)]">
          alex-casal
        </span>
        <p class="mt-1 text-xs uppercase tracking-[0.22em] text-[var(--soft)] sm:text-[0.78rem]">
          developer / Berlin
        </p>
      </a>

      <a
        href="/docs/CV_Alex_Casal.pdf"
        download
        class="group hidden items-center gap-3 rounded-full border border-[var(--line)] bg-[var(--surface-soft)] px-4 py-2 transition duration-300 hover:-translate-y-0.5 hover:border-[var(--accent)] hover:bg-[rgba(var(--accent-rgb),0.08)] hover:shadow-[0_0_24px_rgba(var(--accent-rgb),0.14)] xl:flex"
      >
        <span class="h-2 w-2 rounded-full bg-[var(--accent)] shadow-[0_0_18px_var(--accent)]"></span>
        <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--muted)] transition duration-300 group-hover:text-[var(--ink)]">
          Download CV
        </span>
      </a>

      <nav aria-label="Primary" class="hidden md:block">
        <ul class="flex items-center gap-4 lg:gap-5">
          {links.map((link, index) => (
            <li>
              <a
                href={link.href}
                aria-current={isActive(link.href) ? "page" : undefined}
                data-nav-accent={link.accent}
                class="nav-link group inline-flex items-center gap-2 rounded-full px-2 py-1.5 text-sm"
              >
                <span class:list={[
                  "font-mono text-[0.64rem] uppercase tracking-[0.22em] transition duration-300",
                  isActive(link.href) ? "text-[var(--page-accent)]" : "text-[var(--soft)]",
                ]}>
                  {String(index + 1).padStart(2, "0")}
                </span>
                <span class:list={[
                  "transition duration-300",
                  isActive(link.href) ? "text-[var(--ink)]" : "text-[var(--muted)]",
                ]}>
                  {link.label}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <details class="relative md:hidden">
        <summary class="flex cursor-pointer items-center gap-3 rounded-full border border-[var(--line)] bg-[var(--surface-soft)] px-4 py-2 text-sm text-[var(--ink)] transition duration-300 hover:border-[var(--line-strong)] hover:bg-[var(--surface)]">
          <span>Menu</span>
          <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--muted)]">01</span>
        </summary>

        <div class="mobile-menu absolute right-0 top-[calc(100%+0.85rem)] hidden min-w-[16rem] rounded-[1.5rem] border border-[var(--line)] bg-[var(--surface-strong)] p-3 shadow-[0_24px_80px_rgba(0,0,0,0.35)]">
          <nav aria-label="Mobile">
            <ul class="grid gap-1">
              {links.map((link, index) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={isActive(link.href) ? "page" : undefined}
                    data-nav-accent={link.accent}
                    class:list={[
                      "nav-link flex items-center justify-between rounded-2xl px-4 py-3 text-sm transition duration-300",
                      isActive(link.href)
                        ? "bg-[rgba(var(--page-accent-rgb),0.12)] text-[var(--ink)]"
                        : "text-[var(--muted)] hover:bg-[var(--surface)] hover:text-[var(--ink)]",
                    ]}
                  >
                    <span>{link.label}</span>
                    <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] opacity-70">
                      {String(index + 1).padStart(2, "0")}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-link {
    --nav-accent: var(--accent);
    --nav-accent-rgb: var(--accent-rgb);
  }

  .nav-link[data-nav-accent="home"],
  .nav-link[data-nav-accent="contact"] {
    --nav-accent: #d8ff56;
    --nav-accent-rgb: 216, 255, 86;
  }

  .nav-link[data-nav-accent="about"] {
    --nav-accent: #38bdf8;
    --nav-accent-rgb: 56, 189, 248;
  }

  .nav-link[data-nav-accent="projects"] {
    --nav-accent: #fb923c;
    --nav-accent-rgb: 251, 146, 60;
  }

  .nav-link[data-nav-accent="lab"] {
    --nav-accent: #f472b6;
    --nav-accent-rgb: 244, 114, 182;
  }

  .nav-link[data-nav-accent="experiences"] {
    --nav-accent: #a78bfa;
    --nav-accent-rgb: 167, 139, 250;
  }

  .nav-link:hover span:first-child,
  .nav-link:focus-visible span:first-child {
    color: var(--nav-accent);
  }

  .nav-link:hover span:nth-child(2),
  .nav-link:focus-visible span:nth-child(2) {
    color: var(--ink);
  }

  .nav-link[aria-current="page"] {
    background: rgba(var(--page-accent-rgb), 0.08);
    box-shadow: inset 0 -1px 0 rgba(var(--page-accent-rgb), 0.48), 0 0 22px rgba(var(--page-accent-rgb), 0.1);
  }

  .nav-link[aria-current="page"] span:first-child {
    color: var(--page-accent);
  }

  details[open] .mobile-menu {
    display: grid;
  }
</style>
