---
interface Project {
  name: string;
  title: string;
  kind: string;
  summary: string;
  problem: string;
  built: string;
  techStack: string[];
  learned: string;
  highlights: string[];
  githubUrl: string;
  liveUrl?: string | null;
  language?: string | null;
  updatedLabel: string;
  status: string;
}

interface Props {
  projects: Project[];
  profileUrl: string;
}

const { projects, profileUrl } = Astro.props;
---

<section aria-labelledby="project-grid-title" class="mt-12 lg:mt-16">
  <div
    class="accent-divider flex flex-col gap-5 border-t pt-8 sm:flex-row sm:items-end sm:justify-between"
  >
    <div>
      <p
        class="font-mono text-[0.72rem] uppercase tracking-[0.28em] text-[var(--accent-cool)]"
      >
        Project list
      </p>
      <h2
        id="project-grid-title"
        class="mt-3 font-display text-[clamp(2.2rem,4.4vw,4rem)] leading-[0.94] tracking-[-0.07em] text-[var(--ink)]"
      >
        Selected finished projects.
      </h2>
    </div>
    <a
      href={profileUrl}
      target="_blank"
      rel="noreferrer"
      class="accent-button inline-flex items-center gap-3 rounded-full border bg-[var(--surface-soft)] px-5 py-3 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5"
    >
      View all repositories
      <span
        class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]"
        >GitHub</span
      >
    </a>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {
      projects.map((project, index) => (
        <article
          id={project.name}
          class:list={[
            "accent-card group flex h-full flex-col rounded-[2rem] border border-[var(--line)] p-6 sm:p-8",
            index === 0
              ? "md:col-span-2 xl:col-span-2"
              : "",
          ]}
        >
          <div class="flex items-start justify-between gap-4">
            <div>
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--accent)]">
                {project.status}
              </p>
              <p class="mt-2 font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">
                {project.kind}
              </p>
            </div>
            <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
              {project.updatedLabel}
            </span>
          </div>

          <h3 class="mt-10 font-display text-[clamp(2rem,3.8vw,3.4rem)] leading-[0.93] tracking-[-0.07em] text-[var(--ink)] transition duration-300 group-hover:text-[var(--accent-strong)]">
            {project.title}
          </h3>
          <p class="mt-4 text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
            {project.summary}
          </p>

          <div class="mt-7 grid gap-5 border-t border-[var(--line)] pt-5">
            <div>
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--accent-cool)]">
                Problem
              </p>
              <p class="mt-2 text-sm leading-6 text-[var(--muted)] sm:text-base sm:leading-7">
                {project.problem}
              </p>
            </div>
            <div>
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--accent-cool)]">
                What I built
              </p>
              <p class="mt-2 text-sm leading-6 text-[var(--muted)] sm:text-base sm:leading-7">
                {project.built}
              </p>
            </div>
            <div>
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--accent-cool)]">
                Tech stack
              </p>
              <div class="mt-3 flex flex-wrap gap-2">
                {project.techStack.map((tool) => (
                  <span class="accent-pill rounded-full border px-3 py-1.5 font-mono text-[0.68rem] uppercase tracking-[0.18em]">
                    {tool}
                  </span>
                ))}
              </div>
            </div>
            <div>
              <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--accent-cool)]">
                What I learned
              </p>
              <p class="mt-2 text-sm leading-6 text-[var(--muted)] sm:text-base sm:leading-7">
                {project.learned}
              </p>
            </div>
          </div>

          <ul class="mt-6 grid gap-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
            {project.highlights.map((highlight) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[var(--accent)]"></span>
                <span>{highlight}</span>
              </li>
            ))}
          </ul>

          <div class="mt-6 flex flex-wrap gap-x-4 gap-y-2 border-t border-[var(--line)] pt-4">
            {project.language && (
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">
                {project.language}
              </span>
            )}
            <span class="font-mono text-[0.68rem] uppercase tracking-[0.22em] text-[var(--soft)]">
              #{String(index + 1).padStart(2, "0")}
            </span>
          </div>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              href={project.githubUrl}
              target="_blank"
              rel="noreferrer"
              class="accent-button inline-flex items-center gap-3 rounded-full border bg-[var(--surface-soft)] px-5 py-3 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5"
            >
              GitHub
              <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                repo
              </span>
            </a>
            {project.liveUrl && (
              <a
                href={project.liveUrl}
                target="_blank"
                rel="noreferrer"
                class="accent-button inline-flex items-center gap-3 rounded-full border bg-[var(--surface-soft)] px-5 py-3 text-sm text-[var(--ink)] transition duration-300 hover:-translate-y-0.5"
              >
                Live site
                <span class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
                  open
                </span>
              </a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
