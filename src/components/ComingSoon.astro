---
interface Route {
  href: string;
  note: string;
  title: string;
}

interface Props {
  eyebrow: string;
  title: string;
  intro: string;
  note: string;
  statusLabel: string;
  statusValue: string;
  launchLabel: string;
  launchValue: string;
  cadenceLabel: string;
  cadenceValue: string;
  bullets: string[];
  routes: Route[];
}

const {
  eyebrow,
  title,
  intro,
  note,
  statusLabel,
  statusValue,
  launchLabel,
  launchValue,
  cadenceLabel,
  cadenceValue,
  bullets,
  routes,
} = Astro.props;
---

<section class="relative overflow-hidden border-b border-[var(--line)] pb-16 lg:pb-20">
  <div aria-hidden="true" class="absolute left-[10%] top-8 h-40 w-40 rounded-full bg-[var(--accent-soft)] blur-3xl"></div>

  <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(18rem,0.85fr)] lg:items-end">
    <div>
      <div class="flex items-center gap-4">
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent)]">
          {eyebrow}
        </p>
        <span class="h-px flex-1 bg-[var(--line)]"></span>
      </div>

      <h1 class="mt-6 max-w-[9ch] font-display text-[clamp(3.8rem,10vw,8rem)] leading-[0.88] tracking-[-0.08em] text-[var(--ink)] text-shadow-soft">
        {title}
      </h1>

      <div class="mt-8 max-w-3xl space-y-5 text-lg leading-8 text-[var(--muted)] sm:text-[1.28rem] sm:leading-9">
        <p>{intro}</p>
        <p>{note}</p>
      </div>
    </div>

    <aside class="lg:pb-2">
      <div class="rounded-[2rem] border border-[var(--line)] bg-[linear-gradient(180deg,rgba(255,255,255,0.03),rgba(255,255,255,0.01))] p-6 sm:p-8">
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.28em] text-[var(--accent-cool)]">
          Current status
        </p>

        <dl class="mt-6 space-y-5">
          <div class="border-t border-[var(--line)] pt-5 first:border-t-0 first:pt-0">
            <dt class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
              {statusLabel}
            </dt>
            <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
              {statusValue}
            </dd>
          </div>

          <div class="border-t border-[var(--line)] pt-5">
            <dt class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
              {launchLabel}
            </dt>
            <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
              {launchValue}
            </dd>
          </div>

          <div class="border-t border-[var(--line)] pt-5">
            <dt class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)]">
              {cadenceLabel}
            </dt>
            <dd class="mt-2 text-sm leading-6 text-[var(--ink)] sm:text-base">
              {cadenceValue}
            </dd>
          </div>
        </dl>
      </div>
    </aside>
  </div>
</section>

<section aria-labelledby="coming-soon-plan" class="mt-16 lg:mt-20">
  <div class="flex flex-col gap-6 border-t border-[var(--line-strong)] pt-10 lg:flex-row lg:items-end lg:justify-between lg:pt-12">
    <div>
      <p class="font-mono text-[0.72rem] uppercase tracking-[0.3em] text-[var(--accent-cool)]">
        Coming soon
      </p>
      <h2 id="coming-soon-plan" class="mt-4 max-w-[11ch] font-display text-4xl leading-[0.95] tracking-[-0.07em] text-[var(--ink)] sm:text-5xl lg:text-6xl">
        What will land first.
      </h2>
    </div>
  </div>

  <div class="mt-8 border-t border-[var(--line-strong)]">
    {bullets.map((item, index) => (
      <article class="grid gap-5 border-b border-[var(--line)] py-8 transition duration-300 hover:border-[var(--line-strong)] lg:grid-cols-[4.5rem_minmax(0,1fr)] lg:items-start lg:gap-8">
        <span class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[var(--soft)]">
          {String(index + 1).padStart(2, "0")}
        </span>
        <p class="max-w-3xl text-base leading-7 text-[var(--muted)] sm:text-lg sm:leading-8">
          {item}
        </p>
      </article>
    ))}
  </div>
</section>

<section class="mt-20 lg:mt-28">
  <div class="grid gap-4 lg:grid-cols-2">
    {routes.map((route) => (
      <a
        href={route.href}
        class="group rounded-[2rem] border border-[var(--line)] bg-[var(--surface)] p-6 transition duration-300 hover:-translate-y-1 hover:border-[var(--line-strong)] sm:p-8"
      >
        <p class="font-mono text-[0.68rem] uppercase tracking-[0.24em] text-[var(--soft)] transition duration-300 group-hover:text-[var(--accent)]">
          {route.note}
        </p>
        <h3 class="mt-8 max-w-[11ch] font-display text-4xl leading-[0.95] tracking-[-0.06em] text-[var(--ink)] sm:text-5xl">
          {route.title}
        </h3>
      </a>
    ))}
  </div>
</section>
